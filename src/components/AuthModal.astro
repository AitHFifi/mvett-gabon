---
// AuthModal.astro — Authentification simple pour les contributeurs MVETT
---

<div class="auth-modal-backdrop" id="authModalBackdrop" aria-hidden="true">
  <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="authTitle">
    <button class="modal-close-btn" id="closeAuthModalBtn" type="button" aria-label="Fermer la fenêtre">✕</button>

    <div class="auth-header">
      <span class="auth-badge">Contribution MVETT</span>
      <h2 class="auth-title" id="authTitle">Rejoindre la mémoire des 9 Provinces</h2>
      <p class="auth-subtitle">
        Connectez-vous pour téléverser vos photographies et enrichir l'archive visuelle du Gabon.
      </p>
    </div>

    <!-- Feedback Message -->
    <div class="auth-feedback" id="authFeedback" style="display: none;"></div>

    <div class="auth-actions">
      <!-- Bouton Google 1-clic -->
      <button class="btn-google" id="btnGoogleLogin" type="button">
        <svg class="google-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Continuer avec Google</span>
      </button>

      <div class="auth-divider">
        <span>ou par e-mail sans mot de passe</span>
      </div>

      <!-- Formulaire Magic Link -->
      <form class="magic-link-form" id="magicLinkForm">
        <div class="input-group">
          <input 
            type="email" 
            id="magicEmailInput" 
            class="auth-input" 
            placeholder="votre.email@exemple.com" 
            required 
            autocomplete="email"
          />
          <button type="submit" class="btn-magic" id="btnMagicSubmit">
            Recevoir le lien magique
          </button>
        </div>
      </form>

      <!-- Option Démo / Invité immédiat -->
      <div class="demo-login-box">
        <p class="demo-text">Vous souhaitez tester immédiatement l'interface ?</p>
        <button class="btn-demo" id="btnGuestLogin" type="button">
          ✦ Continuer en mode Démo instantané
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { photoStore } from '../lib/photo-store';

  function initAuthModal() {
    const backdrop = document.getElementById('authModalBackdrop');
    const closeBtn = document.getElementById('closeAuthModalBtn');
    const btnGoogle = document.getElementById('btnGoogleLogin');
    const magicForm = document.getElementById('magicLinkForm');
    const magicInput = document.getElementById('magicEmailInput') as HTMLInputElement | null;
    const btnGuest = document.getElementById('btnGuestLogin');
    const feedback = document.getElementById('authFeedback');

    let pendingNextAction: string | null = null;
    let pendingProvinceId: string | null = null;

    function showFeedback(msg: string, isError: boolean = false) {
      if (!feedback) return;
      feedback.textContent = msg;
      feedback.style.display = 'block';
      feedback.className = `auth-feedback ${isError ? 'error' : 'success'}`;
    }

    function openModal(nextAction?: string, provinceId?: string) {
      if (!backdrop) return;
      pendingNextAction = nextAction || null;
      pendingProvinceId = provinceId || null;
      backdrop.classList.add('open');
      backdrop.setAttribute('aria-hidden', 'false');
      if (feedback) feedback.style.display = 'none';
    }

    function closeModal() {
      if (!backdrop) return;
      backdrop.classList.remove('open');
      backdrop.setAttribute('aria-hidden', 'true');
    }

    function onLoginSuccess() {
      closeModal();
      if (pendingNextAction === 'upload') {
        setTimeout(() => {
          window.dispatchEvent(new CustomEvent('mvett:open-upload', { detail: { provinceId: pendingProvinceId } }));
        }, 300);
      }
    }

    // Écoute des événements personnalisés
    window.addEventListener('mvett:open-auth', ((e: CustomEvent) => {
      openModal(e.detail?.nextAction, e.detail?.provinceId);
    }) as EventListener);

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    // Google Login
    btnGoogle?.addEventListener('click', async () => {
      showFeedback('Connexion en cours...', false);
      const res = await photoStore.loginWithGoogle();
      if (res.error) {
        showFeedback(`Erreur : ${res.error}`, true);
      } else {
        onLoginSuccess();
      }
    });

    // Magic Link
    magicForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = magicInput?.value.trim();
      if (!email) return;

      showFeedback('Traitement en cours...', false);
      const res = await photoStore.loginWithMagicLink(email);
      if (res.error) {
        showFeedback(res.error, true);
      } else {
        showFeedback(res.message || 'Lien envoyé !', false);
        setTimeout(() => onLoginSuccess(), 1000);
      }
    });

    // Mode Invité / Démo
    btnGuest?.addEventListener('click', async () => {
      await photoStore.loginAsGuest('Contributeur Démo');
      showFeedback('Connecté en tant que Contributeur Démo !', false);
      setTimeout(() => onLoginSuccess(), 400);
    });

    // Échap pour fermer
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop?.classList.contains('open')) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuthModal);
  } else {
    initAuthModal();
  }
</script>

<style>
  .auth-modal-backdrop {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(8, 10, 9, 0.72);
    backdrop-filter: blur(28px) saturate(160%);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    z-index: 120;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
  }

  .auth-modal-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  .auth-modal {
    position: relative;
    width: 100%;
    max-width: 480px;
    background: rgba(22, 26, 25, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 20px;
    padding: 2.5rem 2.2rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
    color: #ffffff;
    transform: translateY(16px) scale(0.98);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .auth-modal-backdrop.open .auth-modal {
    transform: translateY(0) scale(1);
  }

  .modal-close-btn {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    color: #ffffff;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .auth-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: rgba(255, 255, 255, 0.12);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.85);
    display: inline-block;
    margin-bottom: 1rem;
  }

  .auth-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.6rem, 2.2vw, 2.1rem);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.65rem;
    letter-spacing: -0.01em;
  }

  .auth-subtitle {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
    opacity: 0.7;
    margin: 0 auto;
  }

  .auth-feedback {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .auth-feedback.success {
    background: rgba(46, 125, 50, 0.25);
    border: 1px solid rgba(76, 175, 80, 0.4);
    color: #a5d6a7;
  }

  .auth-feedback.error {
    background: rgba(198, 40, 40, 0.25);
    border: 1px solid rgba(239, 83, 80, 0.4);
    color: #ef9a9a;
  }

  .auth-actions {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .btn-google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0.85rem 1.2rem;
    background: #ffffff;
    color: #1f2937;
    border: none;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .btn-google:hover {
    background: #f1f3f4;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }

  .auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .auth-divider span {
    padding: 0 0.85rem;
  }

  .magic-link-form {
    width: 100%;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .auth-input {
    width: 100%;
    padding: 0.8rem 1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .auth-input:focus {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.1);
  }

  .btn-magic {
    width: 100%;
    padding: 0.8rem 1rem;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 8px;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-magic:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .demo-login-box {
    margin-top: 0.6rem;
    padding-top: 1.2rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
    text-align: center;
  }

  .demo-text {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 0.5rem;
  }

  .btn-demo {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #f8fafc;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-demo:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .auth-modal {
      padding: 1.6rem 1.2rem;
      border-radius: 16px;
    }
    .auth-title {
      font-size: 1.45rem;
    }
    .auth-input {
      font-size: 16px;
    }
  }
</style>
