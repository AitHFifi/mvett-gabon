---
// DeviceFormats.astro - Section 03 : Formats & Écrans (Scroll-Activated Device Appearances)
import { FORMATS_DATA } from '../../data/journal-emeraude/content';
const { mobileReels, cinemaScreen } = FORMATS_DATA;
---

<section class="emeraude-device-formats" id="formats">
  <div class="formats-container">
    <!-- En-tête de section -->
    <div class="formats-header-wrap">
      <div class="section-badge">
        <span class="badge-num">02</span>
        <span class="badge-separator">/</span>
        <span class="badge-label">FORMATS & ÉCRANS EN MOUVEMENT</span>
      </div>
      <h2 class="formats-headline">
        De la Verticalité Virale à l'Exigence du 24 Images/Seconde.
      </h2>
      <p class="formats-subheadline">
        Deux fenêtres d'expression calibrées avec rigueur : l'intimité mobile des chroniques qui fédèrent des millions d'abonnés, et l'amplitude cinématographique des fictions de prestige.
      </p>
    </div>

    <!-- Double Présentation Appareils Scrollytelling -->
    <div class="devices-scrolly-grid">
      
      <!-- APPAREIL 1 : iPhone Pro Flottant (Chroniques Satiriques 9:16) -->
      <div class="device-column device-column-mobile" id="deviceMobileColumn">
        <div class="device-wrapper-sticky">
          <div class="device-card-content">
            <div class="device-tag-row">
              <span class="device-format-pill">{mobileReels.deviceLabel}</span>
              <span class="device-editorial-tag">CHRONIQUES VERTICALES</span>
            </div>

            <h3 class="device-title">{mobileReels.title}</h3>
            <p class="device-show-name">{mobileReels.showName}</p>
            <p class="device-desc">{mobileReels.description}</p>

            <div class="device-metrics-row">
              <div class="metric-block">
                <span class="metric-num">{mobileReels.reach}</span>
                <span class="metric-lbl">Audience Panafricaine</span>
              </div>
              <div class="metric-separator"></div>
              <div class="metric-block">
                <span class="metric-num">{mobileReels.shares}</span>
                <span class="metric-lbl">Partages Organiques</span>
              </div>
            </div>

            <div class="device-pills-wrap">
              {mobileReels.tags.map((tag) => (
                <span class="pill-chip">{tag}</span>
              ))}
            </div>
          </div>

          <!-- MOCKUP IPHONE PRO HAUTE COUTURE -->
          <div class="mockup-iphone-pro" id="iphoneProMockup" data-cursor="REEL">
            <!-- Châssis Titane Émeraude -->
            <div class="iphone-bezel">
              <!-- Îlot Dynamique (Dynamic Island) -->
              <div class="iphone-dynamic-island">
                <div class="island-camera"></div>
                <div class="island-sensor"></div>
                <div class="island-wave-anim">
                  <span></span><span></span><span></span>
                </div>
              </div>

              <!-- Écran Oled Incurvé -->
              <div class="iphone-screen">
                <img
                  src={mobileReels.image}
                  alt={mobileReels.title}
                  class="iphone-screen-media"
                  loading="lazy"
                />
                
                <!-- Interface Superposée Réseau Social Haute Couture -->
                <div class="iphone-ui-overlay">
                  <div class="ui-top-bar">
                    <span class="ui-clock">09:41</span>
                    <div class="ui-icons">
                      <span>5G</span>
                      <div class="ui-battery"></div>
                    </div>
                  </div>

                  <div class="ui-side-actions">
                    <div class="ui-avatar">
                      <img src="/images/emeraude/martine-myphe-lomba.jpg" alt="Émeraude" />
                      <span class="ui-plus-badge">+</span>
                    </div>
                    <div class="ui-action-btn">
                      <span class="ui-icon">♥</span>
                      <span class="ui-count">482K</span>
                    </div>
                    <div class="ui-action-btn">
                      <span class="ui-icon">💬</span>
                      <span class="ui-count">38.4K</span>
                    </div>
                    <div class="ui-action-btn">
                      <span class="ui-icon">↗</span>
                      <span class="ui-count">125K</span>
                    </div>
                  </div>

                  <div class="ui-bottom-info">
                    <div class="ui-creator">
                      <strong>@MartineMypheLomba</strong>
                      <span class="ui-verified-badge">✓</span>
                    </div>
                    <p class="ui-caption">
                      Quand la société gabonaise se regarde dans le miroir... Chronique n°104 : « Les apparences et le protocole ».
                    </p>
                    <div class="ui-sound-ticker">
                      <span class="sound-symbol">♫</span>
                      <span class="sound-title">Son original — Le Journal d'Émeraude (Saison 2025)</span>
                    </div>
                  </div>
                </div>

                <!-- Lueur de mise sous tension -->
                <div class="screen-glare-effect"></div>
              </div>

              <!-- Barre d'accueil Home Indicator -->
              <div class="iphone-home-indicator"></div>
            </div>
            <!-- Ombre portée portée & lueur d'ambiance -->
            <div class="iphone-ambient-glow"></div>
          </div>
        </div>
      </div>

      <!-- APPAREIL 2 : Moniteur Studio Cinéma (Fictions 16:9) -->
      <div class="device-column device-column-cinema" id="deviceCinemaColumn">
        <div class="device-wrapper-sticky">
          <div class="device-card-content">
            <div class="device-tag-row">
              <span class="device-format-pill pill-gold">{cinemaScreen.deviceLabel}</span>
              <span class="device-editorial-tag tag-gold">CINÉMA D'AUTEUR & SÉRIES</span>
            </div>

            <h3 class="device-title">{cinemaScreen.title}</h3>
            <p class="device-show-name text-gold">{cinemaScreen.activeFilm}</p>
            <p class="device-desc">{cinemaScreen.description}</p>

            <div class="device-metrics-row">
              <div class="metric-block">
                <span class="metric-num text-gold">{cinemaScreen.award}</span>
                <span class="metric-lbl">Palmarès International</span>
              </div>
              <div class="metric-separator"></div>
              <div class="metric-block">
                <span class="metric-num text-gold">{cinemaScreen.resolution}</span>
                <span class="metric-lbl">Norme Broadcast DCI</span>
              </div>
            </div>

            <div class="device-pills-wrap">
              {cinemaScreen.tags.map((tag) => (
                <span class="pill-chip pill-chip-gold">{tag}</span>
              ))}
            </div>
          </div>

          <!-- MOCKUP MONITEUR DE RÉGIE CINÉMA 16:9 -->
          <div class="mockup-cinema-monitor" id="cinemaMonitorMockup" data-cursor="FILM">
            <!-- Châssis Broadcast Usiné -->
            <div class="monitor-frame">
              <!-- En-tête Moniteur Broadcast -->
              <div class="monitor-header-bar">
                <div class="monitor-brand">
                  <span class="brand-square">■</span>
                  <span>SONY FX6 • 4K DCI • RAW LOG</span>
                </div>
                <div class="monitor-tally-rec">
                  <span class="tally-dot"></span>
                  <span class="tally-text">REC [24.00 FPS]</span>
                </div>
                <div class="monitor-timecode">
                  <span>TC 01:24:18:09</span>
                </div>
              </div>

              <!-- Dalle Cinéma 16:9 -->
              <div class="monitor-display">
                <img
                  src={cinemaScreen.image}
                  alt={cinemaScreen.title}
                  class="monitor-media"
                  loading="lazy"
                />

                <!-- Réticule de Cadrage & Grilles Anamorphiques -->
                <div class="monitor-hud-overlay">
                  <div class="hud-crosshair-center">+</div>
                  <div class="hud-safe-zone"></div>
                  
                  <div class="hud-bottom-telemetry">
                    <div class="telemetry-item">
                      <span class="t-lbl">LUT :</span>
                      <span class="t-val">EMERAUDE_GOLD_CINE</span>
                    </div>
                    <div class="telemetry-item">
                      <span class="t-lbl">ISO :</span>
                      <span class="t-val">800</span>
                    </div>
                    <div class="telemetry-item">
                      <span class="t-lbl">IRIS :</span>
                      <span class="t-val">T1.5</span>
                    </div>
                    <div class="telemetry-item">
                      <span class="t-lbl">PROD :</span>
                      <span class="t-val">STÉRILE — FESTICINÉ</span>
                    </div>
                  </div>
                </div>

                <!-- Reflet de Verre Dépoli -->
                <div class="monitor-glass-reflection"></div>
              </div>

              <!-- Pied & Charnières de Régie Studio -->
              <div class="monitor-stand-mount">
                <div class="mount-joint"></div>
                <div class="mount-base"></div>
              </div>
            </div>
            <!-- Lueur Cinématique Arrière-Plan -->
            <div class="monitor-ambient-glow"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (typeof window !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    // Animation au défilement de l'iPhone Pro (mise sous tension et élévation)
    const iphone = document.getElementById('iphoneProMockup');
    if (iphone) {
      gsap.fromTo(
        iphone,
        { y: 60, opacity: 0.8, scale: 0.95 },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: iphone,
            start: 'top 80%',
            end: 'top 30%',
            scrub: 1
          }
        }
      );
    }

    // Animation au défilement du Moniteur Cinéma (déploiement et zoom immersif)
    const monitor = document.getElementById('cinemaMonitorMockup');
    if (monitor) {
      gsap.fromTo(
        monitor,
        { y: 80, opacity: 0.8, rotateX: 6 },
        {
          y: 0,
          opacity: 1,
          rotateX: 0,
          duration: 1.4,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: monitor,
            start: 'top 80%',
            end: 'top 25%',
            scrub: 1
          }
        }
      );
    }
  }
</script>

<style>
  .emeraude-device-formats {
    position: relative;
    padding: 8.5rem 2.5rem;
    background: radial-gradient(circle at 50% 20%, rgba(16, 185, 129, 0.05) 0%, #030806 70%);
    border-top: 1px solid rgba(16, 185, 129, 0.12);
  }

  .formats-container {
    max-width: 1380px;
    margin: 0 auto;
  }

  /* Header */
  .formats-header-wrap {
    max-width: 960px;
    margin-bottom: 5.5rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--color-emeraude-primary);
    margin-bottom: 1.25rem;
    padding: 0.35rem 0.85rem;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 999px;
  }

  .formats-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.2vw, 4rem);
    font-weight: 400;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .formats-subheadline {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 820px;
  }

  /* Grille des Deux Formats */
  .devices-scrolly-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5rem;
  }

  @media (min-width: 1024px) {
    .devices-scrolly-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .device-column {
    background: rgba(8, 26, 20, 0.4);
    border: 1px solid rgba(16, 185, 129, 0.15);
    border-radius: 28px;
    padding: 3rem 2rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .device-column:hover {
    border-color: rgba(16, 185, 129, 0.35);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(16, 185, 129, 0.1);
  }

  .device-column-cinema {
    border-color: rgba(212, 175, 55, 0.2);
    background: rgba(12, 22, 16, 0.45);
  }

  .device-column-cinema:hover {
    border-color: rgba(212, 175, 55, 0.4);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(212, 175, 55, 0.12);
  }

  .device-card-content {
    margin-bottom: 3.5rem;
  }

  .device-tag-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .device-format-pill {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-emeraude-primary);
    background: rgba(16, 185, 129, 0.12);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .pill-gold {
    color: var(--color-gold-primary);
    background: rgba(212, 175, 55, 0.12);
    border-color: rgba(212, 175, 55, 0.3);
  }

  .device-editorial-tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-emeraude-primary);
    text-transform: uppercase;
  }

  .device-editorial-tag.tag-gold {
    color: var(--color-gold-primary);
  }

  .device-title {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 400;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .device-show-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    color: var(--color-emeraude-primary);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .device-desc {
    font-size: 0.98rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .device-metrics-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem;
    background: rgba(4, 16, 12, 0.7);
    border: 1px solid rgba(16, 185, 129, 0.12);
    border-radius: 14px;
    margin-bottom: 1.75rem;
  }

  .metric-block {
    flex: 1;
  }

  .metric-num {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .metric-lbl {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-separator {
    width: 1px;
    height: 36px;
    background: rgba(255, 255, 255, 0.1);
  }

  .device-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill-chip {
    font-size: 0.75rem;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pill-chip-gold {
    color: #f3e5ab;
    border-color: rgba(212, 175, 55, 0.2);
    background: rgba(212, 175, 55, 0.06);
  }

  /* ---------------- MOCKUP IPHONE PRO ---------------- */
  .mockup-iphone-pro {
    position: relative;
    max-width: 320px;
    margin: 0 auto;
    perspective: 1000px;
  }

  .iphone-bezel {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 19.5;
    background: #0d1a14;
    border: 3.5px solid #1a3a2b;
    border-radius: 46px;
    padding: 10px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8),
                inset 0 0 0 1.5px rgba(16, 185, 129, 0.3);
    overflow: hidden;
  }

  .iphone-dynamic-island {
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    width: 95px;
    height: 24px;
    background: #000000;
    border-radius: 20px;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
  }

  .island-camera {
    width: 8px;
    height: 8px;
    background: #081a14;
    border-radius: 50%;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .island-wave-anim {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .island-wave-anim span {
    width: 2px;
    height: 8px;
    background: #10b981;
    border-radius: 1px;
    animation: waveBar 1.2s infinite ease-in-out;
  }

  .island-wave-anim span:nth-child(2) {
    height: 12px;
    animation-delay: 0.2s;
  }
  .island-wave-anim span:nth-child(3) {
    height: 6px;
    animation-delay: 0.4s;
  }

  @keyframes waveBar {
    0%, 100% { transform: scaleY(0.5); }
    50% { transform: scaleY(1); }
  }

  .iphone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 38px;
    overflow: hidden;
    background: #000000;
  }

  .iphone-screen-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.9) contrast(1.1);
    transform: scale(1.02);
    transition: transform 0.6s ease;
  }

  .mockup-iphone-pro:hover .iphone-screen-media {
    transform: scale(1.06);
  }

  .iphone-ui-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px 14px 22px;
    background: linear-gradient(180deg, rgba(0,0,0,0.5) 0%, transparent 25%, transparent 60%, rgba(0,0,0,0.85) 100%);
    color: #ffffff;
    pointer-events: none;
  }

  .ui-top-bar {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 600;
    padding-top: 4px;
  }

  .ui-icons {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ui-battery {
    width: 16px;
    height: 8px;
    border: 1px solid #ffffff;
    border-radius: 2px;
    position: relative;
  }
  .ui-battery::after {
    content: '';
    position: absolute;
    left: 1px;
    top: 1px;
    bottom: 1px;
    width: 10px;
    background: #10b981;
    border-radius: 1px;
  }

  .ui-side-actions {
    align-self: flex-end;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .ui-avatar {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 2px solid #10b981;
    overflow: hidden;
  }

  .ui-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ui-plus-badge {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    background: #10b981;
    color: #030806;
    font-size: 10px;
    font-weight: 900;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ui-action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .ui-icon {
    font-size: 20px;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.6));
  }

  .ui-count {
    font-size: 10px;
    font-weight: 700;
    text-shadow: 0 1px 2px rgba(0,0,0,0.8);
  }

  .ui-bottom-info {
    max-width: 85%;
  }

  .ui-creator {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    margin-bottom: 4px;
  }

  .ui-verified-badge {
    background: #10b981;
    color: #030806;
    font-size: 9px;
    font-weight: 800;
    border-radius: 50%;
    width: 13px;
    height: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ui-caption {
    font-size: 11px;
    line-height: 1.4;
    color: #e2e8f0;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ui-sound-ticker {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    color: #a7f3d0;
    white-space: nowrap;
    overflow: hidden;
  }

  .iphone-home-indicator {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 110px;
    height: 4px;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 2px;
    z-index: 25;
  }

  .iphone-ambient-glow {
    position: absolute;
    inset: 10%;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.3) 0%, transparent 70%);
    filter: blur(40px);
    z-index: -1;
  }

  /* ---------------- MOCKUP MONITEUR CINÉMA ---------------- */
  .mockup-cinema-monitor {
    position: relative;
    width: 100%;
    margin-top: 1rem;
    perspective: 1000px;
  }

  .monitor-frame {
    position: relative;
    width: 100%;
    background: #08100c;
    border: 3px solid #302613;
    border-radius: 18px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.85),
                inset 0 0 0 1px rgba(212, 175, 55, 0.3);
    overflow: hidden;
  }

  .monitor-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background: #050a08;
    border-bottom: 1px solid rgba(212, 175, 55, 0.15);
    font-family: var(--font-heading);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: #94a39d;
  }

  .monitor-brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #cbd5e1;
  }

  .brand-square {
    color: var(--color-gold-primary);
  }

  .monitor-tally-rec {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #ef4444;
    font-weight: 700;
  }

  .tally-dot {
    width: 7px;
    height: 7px;
    background: #ef4444;
    border-radius: 50%;
