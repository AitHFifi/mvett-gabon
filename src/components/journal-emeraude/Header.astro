---
// Header.astro - Navigation haute couture épurée (Style Maison de Cinéma & de Création)
---

<header class="emeraude-header" id="emeraudeHeader">
  <div class="header-container">
    <!-- Logo & Identité Typographique Pure (Zéro Losange ni Balise) -->
    <a href="#hero" class="brand-logo" data-cursor="ACCUEIL">
      <div class="logo-text">
        <span class="logo-title">LE JOURNAL D'ÉMERAUDE</span>
        <span class="logo-subtitle">MARTINE MYPHE LOMBA</span>
      </div>
    </a>

    <!-- Navigation Textuelle Fluide & Discrète -->
    <nav class="nav-links-wrap" aria-label="Navigation principale">
      <a href="#manifeste" class="nav-link" data-cursor="LIRE">Manifeste</a>
      <a href="#formats" class="nav-link" data-cursor="FORMATS">Formats & Fictions</a>
      <a href="#showcase" class="nav-link" data-cursor="ŒUVRES">Œuvres</a>
      <a href="#studio" class="nav-link" data-cursor="STUDIO">L'Agence</a>
      <a href="#donnees" class="nav-link" data-cursor="DONNÉES">Données</a>
      <a href="#recommandations" class="nav-link" data-cursor="AVIS">Éloges</a>
    </nav>

    <!-- Action Sobre « Contact & Partenariats » -->
    <div class="header-actions">
      <a href="#partenariats" class="nav-contact-link" data-cursor="CONTACT">
        <span class="contact-text">Contact & Partenariats</span>
        <span class="contact-arrow" aria-hidden="true">→</span>
      </a>

      <!-- Bouton Menu Mobile Minimaliste -->
      <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Ouvrir le menu">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>

  <!-- Menu Mobile Plein Écran Haute Couture -->
  <div class="mobile-nav-panel" id="mobileNavPanel">
    <div class="mobile-nav-content">
      <span class="mobile-nav-eyebrow">SOMMAIRE ÉDITORIAL</span>
      <a href="#manifeste" class="mobile-nav-link">Manifeste</a>
      <a href="#formats" class="mobile-nav-link">Formats & Fictions</a>
      <a href="#showcase" class="mobile-nav-link">Œuvres & Réalisations</a>
      <a href="#studio" class="mobile-nav-link">L'Agence & Studio 4K</a>
      <a href="#donnees" class="mobile-nav-link">Données & Impact</a>
      <a href="#recommandations" class="mobile-nav-link">Éloges & Presse</a>
      <a href="#partenariats" class="mobile-nav-link mobile-nav-highlight">Initier une Collaboration →</a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('emeraudeHeader');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Menu Mobile
  const toggle = document.getElementById('mobileMenuToggle');
  const panel = document.getElementById('mobileNavPanel');
  const mobileLinks = panel?.querySelectorAll('a');

  toggle?.addEventListener('click', () => {
    toggle.classList.toggle('active');
    panel?.classList.toggle('active');
  });

  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.classList.remove('active');
      panel?.classList.remove('active');
    });
  });
</script>

<style>
  .emeraude-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 900;
    padding: 1.75rem 3rem;
    transition: padding 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
                background-color 0.4s ease, 
                border-color 0.4s ease;
  }

  .emeraude-header.scrolled {
    padding: 1.15rem 3rem;
    background: rgba(3, 8, 6, 0.88);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .header-container {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .brand-logo {
    text-decoration: none;
    color: #ffffff;
    display: block;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #f8faf9;
    transition: color 0.3s ease;
  }

  .brand-logo:hover .logo-title {
    color: var(--color-gold-light);
  }

  .logo-subtitle {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  /* Navigation Épurée */
  .nav-links-wrap {
    display: none;
    align-items: center;
    gap: 2.25rem;
  }

  @media (min-width: 1024px) {
    .nav-links-wrap {
      display: flex;
    }
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.3s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-gold-primary);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Action Contact Discrète */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-contact-link {
    display: none;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-gold-light);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 0.45rem 0;
    position: relative;
    transition: color 0.3s ease;
  }

  .nav-contact-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: rgba(212, 175, 55, 0.4);
    transition: background-color 0.3s ease;
  }

  .nav-contact-link:hover {
    color: #ffffff;
  }

  .nav-contact-link:hover::after {
    background: var(--color-gold-primary);
  }

  .contact-arrow {
    font-size: 0.95rem;
    transition: transform 0.3s ease;
  }

  .nav-contact-link:hover .contact-arrow {
    transform: translateX(3px);
  }

  @media (min-width: 768px) {
    .nav-contact-link {
      display: inline-flex;
    }
  }

  /* Bouton Mobile Toggle */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .menu-bar {
    width: 24px;
    height: 1.5px;
    background: #ffffff;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .mobile-menu-toggle.active .menu-bar:nth-child(1) {
    transform: translateY(3.75px) rotate(45deg);
  }

  .mobile-menu-toggle.active .menu-bar:nth-child(2) {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* Panneau Mobile Plein Écran */
  .mobile-nav-panel {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #030806;
    z-index: 850;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .mobile-nav-panel.active {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .mobile-nav-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    color: var(--color-gold-primary);
    margin-bottom: 0.5rem;
  }

  .mobile-nav-link {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: #e2e8f0;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .mobile-nav-link:hover {
    color: var(--color-gold-light);
  }

  .mobile-nav-highlight {
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: 0.12em;
    color: var(--color-gold-primary);
    margin-top: 1rem;
  }
</style>
