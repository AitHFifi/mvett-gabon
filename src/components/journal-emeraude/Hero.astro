---
// Hero.astro - Section 01 : Hero Poster Cinématographique Haute Couture (Style A24 & HOORAE Media)
---

<section class="emeraude-hero" id="hero">
  <!-- Toile de Fond Photographique Pure avec Grain Argentique 35mm & Parallaxe -->
  <div class="hero-media-stage" id="heroMediaStage">
    <div class="hero-image-scroller" id="heroImageScroller">
      <img
        src="/images/emeraude/martine-myphe-lomba.jpg"
        alt="Martine Myphe Lomba — Émeraude"
        class="hero-portrait-cinematic"
        id="heroPortraitImg"
      />
    </div>

    <!-- Grain Pellicule Argentique 35mm (SVG Noise Filter) -->
    <div class="film-grain-overlay" aria-hidden="true"></div>

    <!-- Dégradés Cinématographiques Obsidienne & Velours Émeraude -->
    <div class="cinematic-shadow-overlay"></div>
  </div>

  <!-- Composition Typographique Asymétrique Haute Couture (Poster de Cinéma) -->
  <div class="hero-editorial-wrap">
    <div class="hero-bottom-manifesto">
      <!-- Tagline en Italique Couture -->
      <p class="hero-poetic-lead">
        <em>« Plus qu'une voix, une onde culturelle. »</em>
      </p>

      <!-- Nom Monumental Sculpté -->
      <h1 class="hero-monumental-name">
        MARTINE MYPHE LOMBA
      </h1>

      <!-- Vocation & Identité de Marque -->
      <div class="hero-meta-disciplines">
        <span class="discipline-tag">Actrice de Cinéma</span>
        <span class="discipline-sep">•</span>
        <span class="discipline-tag">Chroniqueuse d'Opinion</span>
        <span class="discipline-sep">•</span>
        <span class="discipline-tag">Fondatrice de Studio</span>
      </div>
    </div>
  </div>

  <!-- Ligne d'Ancrage Éditoriale Sobre en Pied d'Écran -->
  <div class="hero-grounding-bar">
    <div class="grounding-left">
      <span class="geo-label">Libreville, Gabon</span>
      <span class="geo-sep">—</span>
      <span class="studio-label">Le Journal d'Émeraude • Studio Fondé en 2025</span>
    </div>

    <a href="#manifeste" class="grounding-right-cue" data-cursor="DÉCOUVRIR">
      <span class="cue-text">Défiler</span>
      <span class="cue-hairline" aria-hidden="true"></span>
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (typeof window !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    // Parallaxe cinématographique au défilement (Style A24)
    const portrait = document.getElementById('heroPortraitImg');
    const heroWrap = document.querySelector('.hero-editorial-wrap');

    if (portrait) {
      gsap.to(portrait, {
        yPercent: 18,
        scale: 1.08,
        ease: 'none',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        }
      });
    }

    if (heroWrap) {
      gsap.to(heroWrap, {
        yPercent: -12,
        opacity: 0.2,
        ease: 'none',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        }
      });
    }
  }
</script>

<style>
  .emeraude-hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    min-height: 720px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background-color: #030806;
  }

  /* ---------------- SCÈNE VISUELLE & GRAIN ---------------- */
  .hero-media-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-image-scroller {
    position: absolute;
    inset: -5%;
    width: 110%;
    height: 110%;
  }

  .hero-portrait-cinematic {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 25%;
    filter: brightness(0.68) contrast(1.16) saturate(1.05);
    animation: gentleBreathing 24s infinite alternate ease-in-out;
    transform: scale(1.02);
  }

  @keyframes gentleBreathing {
    0% {
      transform: scale(1.02);
      filter: brightness(0.68) contrast(1.16);
    }
    100% {
      transform: scale(1.07);
      filter: brightness(0.72) contrast(1.18);
    }
  }

  /* Grain Argentique 35mm */
  .film-grain-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.28;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  /* Dégradé d'Ombres Obsidienne & Émeraude Sombre */
  .cinematic-shadow-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: 
      linear-gradient(180deg, rgba(3, 8, 6, 0.45) 0%, transparent 35%),
      linear-gradient(0deg, #030806 0%, rgba(3, 8, 6, 0.9) 25%, rgba(4, 16, 12, 0.4) 65%, transparent 100%),
      radial-gradient(circle at 75% 35%, rgba(16, 185, 129, 0.12) 0%, transparent 60%);
  }

  /* ---------------- COMPOSITION TYPOGRAPHIQUE ASYMÉTRIQUE ---------------- */
  .hero-editorial-wrap {
    position: relative;
    z-index: 10;
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 3rem 6.5rem;
    pointer-events: none;
  }

  .hero-bottom-manifesto {
    max-width: 1100px;
  }

  .hero-poetic-lead {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.2vw, 2.2rem);
    font-weight: 300;
    color: var(--color-gold-light);
    letter-spacing: 0.02em;
    margin-bottom: 0.75rem;
    opacity: 0.95;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8);
  }

  .hero-poetic-lead em {
    font-style: italic;
  }

  .hero-monumental-name {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #f8faf9;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.85);
  }

  .hero-meta-disciplines {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-family: var(--font-heading);
    font-size: clamp(0.72rem, 1vw, 0.88rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .discipline-tag {
    color: #cbd5e1;
    transition: color 0.3s ease;
  }

  .discipline-sep {
    color: var(--color-gold-primary);
    opacity: 0.6;
  }

  /* ---------------- PIED D'ÉCRAN SOBRE & REPÈRES ---------------- */
  .hero-grounding-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, transparent 0%, rgba(3, 8, 6, 0.8) 100%);
  }

  .grounding-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #94a39d;
  }

  .geo-label {
    color: #ffffff;
    font-weight: 600;
  }

  .geo-sep {
    color: var(--color-gold-primary);
    opacity: 0.5;
  }

  .studio-label {
    color: var(--color-text-muted);
  }

  .grounding-right-cue {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #cbd5e1;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .grounding-right-cue:hover {
    color: var(--color-gold-light);
  }

  .cue-hairline {
    width: 32px;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
    position: relative;
    overflow: hidden;
    display: inline-block;
  }

  .cue-hairline::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-gold-primary);
    transform: translateX(-100%);
    animation: hairlineTravel 2.4s infinite cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes hairlineTravel {
    0% { transform: translateX(-100%); }
    50%, 100% { transform: translateX(100%); }
  }

  @media (max-width: 768px) {
    .emeraude-hero {
      padding-bottom: 2rem;
    }
    .hero-editorial-wrap {
      padding: 0 1.5rem 5.5rem;
    }
    .hero-grounding-bar {
      padding: 1.25rem 1.5rem;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .grounding-right-cue {
      align-self: flex-end;
    }
  }
</style>
