---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MVETT — Les 9 Provinces du Gabon",
  description = "Une exploration photographique et cinématique des 9 provinces du Gabon, inspirée par Smörgåsbord Studio."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts: Cormorant Garamond, Space Grotesk & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'Space Grotesk', monospace;
    --transition-speed: 0.85s;
    --transition-ease: cubic-bezier(0.16, 1, 0.3, 1);
  }

  body, html {
    width: 100%;
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    background-color: #111413;
    color: #ffffff;
    font-family: var(--font-main);
    -webkit-font-smoothing: antialiased;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Universal custom scrollbar */
  ::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }

  /* Masquer le HUD et le Ticker quand le panneau info plein écran est ouvert pour éviter les collisions visuelles */
  body.info-overlay-open .hud-overlay,
  body.info-overlay-open .footer-ticker-bar,
  body.info-overlay-open .mobile-nav-controls,
  body:has(#infoOverlay.open) .hud-overlay,
  body:has(#infoOverlay.open) .footer-ticker-bar,
  body:has(#infoOverlay.open) .mobile-nav-controls {
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
</style>
