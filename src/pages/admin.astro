    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .admin-modal-backdrop.open {
    opacity: 1;
    visibility: visible;
  }

  .admin-modal-box {
    width: 100%;
    max-width: 680px;
    max-height: 92vh;
    background: rgba(18, 22, 21, 0.98);
