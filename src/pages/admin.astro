  /* ========================================================
     MODALES D'AJOUT, D'ÉDITION ET DE SUPPRESSION
     ======================================================== */
  .admin-modal-backdrop {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(5, 8, 7, 0.85);
    backdrop-filter: blur(25px);
    z-index: 180;
