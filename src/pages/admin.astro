---
import Layout from '../layouts/Layout.astro';
import { provinces } from '../data/provinces';
---

<Layout title="MVETT — Espace Modération & Curation">
  <div class="admin-wrapper" id="adminWrapper">
    
    <!-- Top Navigation Header -->
    <header class="admin-header">
      <div class="header-left">
        <a href="/" class="brand-link" title="Retour au Diaporama">
          <span class="brand-title">MVETT</span>
          <span class="admin-pill">Curation & Modération</span>
        </a>
      </div>

      <div class="header-right">
        <a href="/" class="btn-back-home">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Retour au Diaporama 3D</span>
        </a>

        <!-- Pastille utilisateur -->
        <div class="user-pill" id="adminUserPill" style="display: none;">
          <img class="user-avatar" id="adminUserAvatar" src="" alt="" />
          <span class="user-name" id="adminUserName"></span>
          <button class="btn-logout" id="adminBtnLogout" title="Déconnexion" type="button">✕</button>
        </div>
      </div>
    </header>

    <!-- Écran de verrouillage / Connexion si non-admin -->
    <section class="admin-auth-gate" id="adminAuthGate" style="display: none;">
      <div class="gate-card">
        <div class="gate-badge">Accès Réservé</div>
        <h1 class="gate-title">Espace Curation du Patrimoine</h1>
        <p class="gate-desc">
          Cet espace permet d'examiner et de valider les photographies citoyennes avant leur diffusion officielle dans le grand diaporama 3D des 9 provinces du Gabon.
        </p>

        <div class="gate-actions">
          <button type="button" class="btn-google-login" id="btnAdminGoogle">
            <svg viewBox="0 0 24 24" width="18" height="18">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Connexion Google (Compte Curateur)</span>
          </button>

          <button type="button" class="btn-demo-admin" id="btnAdminDemo">
            ✦ Débloquer en Mode Démo Admin
          </button>
        </div>
      </div>
    </section>

    <!-- Tableau de bord de modération (Actif une fois connecté en admin) -->
    <main class="admin-dashboard" id="adminDashboard" style="display: none;">
      
      <!-- KPI Stats Bar -->
      <section class="kpi-grid">
        <div class="kpi-card highlight-pending">
          <div class="kpi-icon">⏳</div>
          <div class="kpi-data">
            <span class="kpi-value" id="countPending">0</span>
            <span class="kpi-label">À valider (Pending)</span>
          </div>
        </div>

        <div class="kpi-card highlight-approved">
          <div class="kpi-icon">✓</div>
          <div class="kpi-data">
            <span class="kpi-value" id="countApproved">0</span>
            <span class="kpi-label">Diffusées en 3D</span>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon">📷</div>
          <div class="kpi-data">
            <span class="kpi-value" id="countTotal">0</span>
            <span class="kpi-label">Total Contributions</span>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon">🇬🇦</div>
          <div class="kpi-data">
            <span class="kpi-value">9 / 9</span>
            <span class="kpi-label">Provinces du Gabon</span>
          </div>
        </div>
      </section>

      <!-- Contrôles et Filtres -->
      <section class="admin-controls">
        <!-- Filtre Statut -->
        <div class="status-tabs">
          <button type="button" class="tab-btn active" data-status="pending">
            ⏳ En attente <span class="tab-counter" id="tabPendingBadge">0</span>
          </button>
          <button type="button" class="tab-btn" data-status="approved">
            ✓ Approuvées <span class="tab-counter" id="tabApprovedBadge">0</span>
          </button>
          <button type="button" class="tab-btn" data-status="all">
            Toutes les photos
          </button>
        </div>

        <!-- Filtre Province -->
        <div class="province-selector-wrapper">
          <select id="adminProvinceFilter" class="admin-select">
            <option value="all">Toutes les provinces (G1 à G9)</option>
            {provinces.map((prov) => (
              <option value={prov.id}>
                {prov.code} — {prov.name} ({prov.capital})
              </option>
            ))}
          </select>
        </div>
      </section>

      <!-- Grille des photographies soumises (Taille maîtrisée, pas d'étirement géant) -->
      <section class="submissions-grid" id="submissionsGrid">
        <!-- Rempli dynamiquement en JS -->
      </section>

      <!-- État vide -->
      <div class="admin-empty-state" id="adminEmptyState" style="display: none;">
        <div class="empty-icon">🌿</div>
        <h3 class="empty-title">Aucune photo dans cette catégorie</h3>
        <p class="empty-desc">Toutes les contributions ont été traitées ou aucune photo ne correspond aux filtres.</p>
      </div>

    </main>

    <!-- Modale Studio de Prévisualisation Multi-Écrans (Laptop 16:9 vs Smartphone 9:16) -->
    <div class="preview-modal-backdrop" id="previewModalBackdrop" aria-hidden="true">
      <div class="preview-modal-container" role="dialog" aria-modal="true" aria-labelledby="previewModalTitle">
        
        <!-- Header du studio -->
        <header class="preview-modal-header">
          <div class="preview-header-info">
            <div class="preview-badge-row">
              <span class="preview-badge-province" id="previewModalProvince">G1 · Estuaire</span>
              <span class="preview-badge-ratio" id="previewModalRatio">Format : Inconnu</span>
              <span class="preview-badge-status" id="previewModalStatus">En attente</span>
            </div>
            <h2 class="preview-modal-title" id="previewModalTitle">Titre de l'œuvre</h2>
            <p class="preview-modal-location" id="previewModalLocation">Lieu · Auteur</p>
          </div>

          <!-- Switcher d'Écrans Interactif -->
          <div class="device-switcher" role="tablist">
            <button type="button" class="device-btn active" data-device="laptop" id="btnDeviceLaptop">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
              <span>💻 Laptop (16:9)</span>
            </button>
            <button type="button" class="device-btn" data-device="mobile" id="btnDeviceMobile">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                <line x1="12" y1="18" x2="12.01" y2="18"></line>
              </svg>
              <span>📱 Smartphone (9:16)</span>
            </button>
          </div>

          <button type="button" class="btn-close-modal" id="btnClosePreviewModal" aria-label="Fermer le studio">✕</button>
        </header>

        <!-- Stage de Rendu & Simulation -->
        <div class="preview-stage-viewport">
          
          <!-- Mode Laptop (16:9) -->
          <div class="screen-frame-laptop" id="frameLaptop">
            <div class="laptop-bezel">
              <div class="laptop-display" id="laptopDisplay">
                <!-- Arrière-plan flouté cinématique (pour photos portrait) -->
                <div class="laptop-bg-blur" id="laptopBgBlur"></div>
                <!-- Image Principale centrée -->
                <div class="laptop-image-holder" id="laptopImageHolder">
                  <img src="" id="laptopMainImg" alt="Prévisualisation Laptop" />
                </div>
                <!-- Mockup de HUD Dépoli sur l'écran -->
                <div class="hud-mock-overlay">
                  <div class="hud-mock-top">
                    <span class="mock-brand">MVETT</span>
                    <span class="mock-counter" id="laptopMockCounter">01 / 03 · G1 ESTUAIRE</span>
                  </div>
                  <div class="hud-mock-bottom">
                    <h4 class="mock-title" id="laptopMockTitle">Titre de l'œuvre</h4>
                    <p class="mock-loc" id="laptopMockLoc">Lieu précis</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="laptop-keyboard-base"></div>
          </div>

          <!-- Mode Smartphone (9:16) -->
          <div class="screen-frame-mobile" id="frameMobile" style="display: none;">
            <div class="mobile-case">
              <div class="mobile-notch"></div>
              <div class="mobile-display" id="mobileDisplay">
                <img src="" id="mobileMainImg" alt="Prévisualisation Mobile" />
                <!-- Mockup HUD Mobile -->
                <div class="hud-mock-overlay mobile">
                  <div class="hud-mock-top">
                    <span class="mock-brand">MVETT</span>
                  </div>
                  <div class="hud-mock-bottom">
                    <h4 class="mock-title" id="mobileMockTitle">Titre</h4>
                    <p class="mock-loc" id="mobileMockLoc">Lieu précis</p>
                  </div>
                </div>
              </div>
              <div class="mobile-home-bar"></div>
            </div>
          </div>

        </div>

        <!-- Toolbar d'Actions de Modération -->
        <footer class="preview-modal-footer">
          <div class="footer-info">
            <p class="footer-tip" id="previewFormatTip">
              ℹ️ Ce cliché s'adaptera automatiquement selon l'appareil du visiteur.
            </p>
          </div>

          <div class="footer-buttons">
            <button type="button" class="btn-modal-action-reject" id="btnModalReject">
              ✕ Rejeter la photo
            </button>
            <button type="button" class="btn-modal-action-approve" id="btnModalApprove">
              ✓ Approuver pour le Diaporama 3D
            </button>
          </div>
        </footer>

      </div>
    </div>

  </div>
</Layout>

<script>
  import { photoStore, type CommunityPhoto, type UserProfile } from '../lib/photo-store';
  import { provinces } from '../data/provinces';

  document.addEventListener('DOMContentLoaded', async () => {
    const authGate = document.getElementById('adminAuthGate');
    const dashboard = document.getElementById('adminDashboard');
    const userPill = document.getElementById('adminUserPill');
    const userAvatar = document.getElementById('adminUserAvatar') as HTMLImageElement | null;
    const userName = document.getElementById('adminUserName');
    const btnLogout = document.getElementById('adminBtnLogout');
    const btnGoogle = document.getElementById('btnAdminGoogle');
    const btnDemo = document.getElementById('btnAdminDemo');

    const countPending = document.getElementById('countPending');
    const countApproved = document.getElementById('countApproved');
    const countTotal = document.getElementById('countTotal');
    const tabPendingBadge = document.getElementById('tabPendingBadge');
    const tabApprovedBadge = document.getElementById('tabApprovedBadge');

    const statusTabs = document.querySelectorAll('.tab-btn');
    const provinceFilter = document.getElementById('adminProvinceFilter') as HTMLSelectElement | null;
    const grid = document.getElementById('submissionsGrid');
    const emptyState = document.getElementById('adminEmptyState');

    // Éléments du Studio de Prévisualisation Modal
    const previewBackdrop = document.getElementById('previewModalBackdrop');
    const btnClosePreview = document.getElementById('btnClosePreviewModal');
    const previewModalProvince = document.getElementById('previewModalProvince');
    const previewModalRatio = document.getElementById('previewModalRatio');
    const previewModalStatus = document.getElementById('previewModalStatus');
    const previewModalTitle = document.getElementById('previewModalTitle');
    const previewModalLocation = document.getElementById('previewModalLocation');
    const btnDeviceLaptop = document.getElementById('btnDeviceLaptop');
    const btnDeviceMobile = document.getElementById('btnDeviceMobile');
    const frameLaptop = document.getElementById('frameLaptop');
    const frameMobile = document.getElementById('frameMobile');
    const laptopMainImg = document.getElementById('laptopMainImg') as HTMLImageElement | null;
    const laptopBgBlur = document.getElementById('laptopBgBlur') as HTMLElement | null;
    const laptopImageHolder = document.getElementById('laptopImageHolder');
    const laptopMockCounter = document.getElementById('laptopMockCounter');
    const laptopMockTitle = document.getElementById('laptopMockTitle');
    const laptopMockLoc = document.getElementById('laptopMockLoc');
    const mobileMainImg = document.getElementById('mobileMainImg') as HTMLImageElement | null;
    const mobileMockTitle = document.getElementById('mobileMockTitle');
    const mobileMockLoc = document.getElementById('mobileMockLoc');
    const previewFormatTip = document.getElementById('previewFormatTip');
    const btnModalApprove = document.getElementById('btnModalApprove') as HTMLButtonElement | null;
    const btnModalReject = document.getElementById('btnModalReject') as HTMLButtonElement | null;

    let currentStatusFilter: 'pending' | 'approved' | 'all' = 'pending';
    let currentProvinceFilter: string = 'all';
    let currentUser: UserProfile | null = null;
    let allPhotos: CommunityPhoto[] = [];
    let currentPreviewPhoto: CommunityPhoto | null = null;

    // Vérification session & droits
    async function checkAuth() {
      currentUser = await photoStore.getCurrentUser();
      renderAuthUI();
      if (currentUser) {
        await loadPhotos();
      }
    }

    function renderAuthUI() {
      const isAuth = !!currentUser;
      const isAdmin = currentUser && (photoStore.isAdmin(currentUser) || currentUser.isDemo);

      if (isAdmin) {
        if (authGate) authGate.style.display = 'none';
        if (dashboard) dashboard.style.display = 'block';
        if (userPill) userPill.style.display = 'inline-flex';
        if (userName) userName.textContent = `${currentUser.name} (Admin)`;
        if (userAvatar && currentUser.avatar) userAvatar.src = currentUser.avatar;
      } else {
        if (authGate) authGate.style.display = 'flex';
        if (dashboard) dashboard.style.display = 'none';
        if (userPill) userPill.style.display = 'none';
      }
    }

    async function loadPhotos() {
      allPhotos = await photoStore.getPhotos({ status: 'all' });
      updateCounts();
      renderCards();
    }

    function updateCounts() {
      const pendingList = allPhotos.filter((p) => p.status === 'pending');
      const approvedList = allPhotos.filter((p) => p.status === 'approved');

      if (countPending) countPending.textContent = String(pendingList.length);
      if (countApproved) countApproved.textContent = String(approvedList.length);
      if (countTotal) countTotal.textContent = String(allPhotos.length);

      if (tabPendingBadge) tabPendingBadge.textContent = String(pendingList.length);
      if (tabApprovedBadge) tabApprovedBadge.textContent = String(approvedList.length);
    }

    function renderCards() {
      if (!grid || !emptyState) return;

      let filtered = allPhotos;

      // Filtre par statut
      if (currentStatusFilter !== 'all') {
        filtered = filtered.filter((p) => p.status === currentStatusFilter);
      }

      // Filtre par province
      if (currentProvinceFilter !== 'all') {
        filtered = filtered.filter((p) => p.province_id === currentProvinceFilter);
      }

      if (filtered.length === 0) {
        grid.innerHTML = '';
        emptyState.style.display = 'flex';
        return;
      }

      emptyState.style.display = 'none';

      grid.innerHTML = filtered.map((photo) => {
        const prov = provinces.find((p) => p.id === photo.province_id);
        const provName = prov ? `${prov.code} · ${prov.name}` : photo.province_id;
        const dateStr = new Date(photo.created_at).toLocaleDateString('fr-FR', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        });

        const isApproved = photo.status === 'approved';
        const isPending = photo.status === 'pending';

        return `
          <article class="submission-card ${photo.status}" data-photo-id="${photo.id}">
            <div class="card-thumb" data-preview-id="${photo.id}" title="Cliquer pour prévisualiser (Laptop & Mobile)">
              <img src="${photo.image_url}" alt="${photo.title}" loading="lazy" class="thumb-img" />
              <div class="card-status-badge ${photo.status}">
                ${isApproved ? '✓ Approuvée' : isPending ? '⏳ En Attente' : '✕ Rejetée'}
              </div>
              <span class="card-province-badge">${provName}</span>
              <div class="thumb-overlay-hint">
                <span>👁 Prévisualiser</span>
              </div>
            </div>

            <div class="card-body">
              <div class="card-top">
                <h3 class="card-title">${photo.title}</h3>
                <p class="card-location">${photo.location}</p>
              </div>

              ${photo.caption ? `<p class="card-caption">« ${photo.caption} »</p>` : '<p class="card-caption empty">Aucune légende fournie</p>'}

              <div class="card-contributor">
                ${photo.user_avatar ? `<img src="${photo.user_avatar}" class="contributor-avatar" alt="" />` : `<span class="contributor-initial">${photo.user_name.charAt(0)}</span>`}
                <div class="contributor-meta">
                  <span class="contributor-name">${photo.user_name}</span>
                  <span class="submission-date">${dateStr}</span>
                </div>
              </div>

              <!-- Bouton Prévisualisation Multi-Écrans -->
              <button type="button" class="btn-card-preview" data-preview-id="${photo.id}">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <span>Tester Laptop & Mobile</span>
              </button>

              <div class="card-actions">
                ${!isApproved ? `
                  <button type="button" class="btn-action-approve" data-approve-id="${photo.id}">
                    ✓ Approuver
                  </button>
                ` : `
                  <a href="/?photo=${photo.id}" class="btn-action-view" target="_blank">
                    👁 Diaporama ↗
                  </a>
                `}

                <button type="button" class="btn-action-reject" data-reject-id="${photo.id}" title="Rejeter et retirer">
                  ${isApproved ? 'Retirer' : 'Rejeter'}
                </button>
              </div>
            </div>
          </article>
        `;
      }).join('');

      // Attacher les clics d'ouverture du Studio de Prévisualisation
      grid.querySelectorAll('[data-preview-id]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const pId = (el as HTMLElement).getAttribute('data-preview-id');
          if (pId) {
            const photo = allPhotos.find((p) => p.id === pId);
            if (photo) openPreviewModal(photo);
          }
        });
      });

      // Attacher les clics d'approbation et de rejet directs
      grid.querySelectorAll('.btn-action-approve').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-approve-id');
          if (pId) {
            btn.textContent = 'Approbation...';
            (btn as HTMLButtonElement).disabled = true;
            await photoStore.approvePhoto(pId);
            await loadPhotos();
          }
        });
      });

      grid.querySelectorAll('.btn-action-reject').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-reject-id');
          if (pId && confirm('Voulez-vous rejeter cette photographie ?')) {
            await photoStore.rejectPhoto(pId);
            await loadPhotos();
          }
        });
      });
    }

    // ========================================================
    // STUDIO DE PRÉVISUALISATION MULTI-ÉCRANS
    // ========================================================

    function openPreviewModal(photo: CommunityPhoto) {
      if (!previewBackdrop) return;
      currentPreviewPhoto = photo;

      const prov = provinces.find((p) => p.id === photo.province_id);
      const provName = prov ? `${prov.code} · ${prov.name}` : photo.province_id;

      if (previewModalProvince) previewModalProvince.textContent = provName;
      if (previewModalTitle) previewModalTitle.textContent = photo.title;
      if (previewModalLocation) previewModalLocation.textContent = `${photo.location} — par ${photo.user_name}`;
      
      if (previewModalStatus) {
        previewModalStatus.textContent = photo.status === 'approved' ? '✓ Diffusée en 3D' : '⏳ En attente';
        previewModalStatus.className = `preview-badge-status ${photo.status}`;
      }

      // Configuration Laptop Mock
      if (laptopMainImg) laptopMainImg.src = photo.image_url;
      if (laptopBgBlur) laptopBgBlur.style.backgroundImage = `url("${photo.image_url}")`;
      if (laptopMockCounter) laptopMockCounter.textContent = `01 / 03 · ${prov ? prov.code : 'G1'} ${(prov ? prov.name : 'GABON').toUpperCase()}`;
      if (laptopMockTitle) laptopMockTitle.textContent = photo.title;
      if (laptopMockLoc) laptopMockLoc.textContent = photo.location;

      // Configuration Mobile Mock
      if (mobileMainImg) mobileMainImg.src = photo.image_url;
      if (mobileMockTitle) mobileMockTitle.textContent = photo.title;
      if (mobileMockLoc) mobileMockLoc.textContent = photo.location;

      // Bouton actions modale
      if (btnModalApprove) {
        btnModalApprove.style.display = photo.status === 'approved' ? 'none' : 'inline-flex';
      }
      if (btnModalReject) {
        btnModalReject.textContent = photo.status === 'approved' ? 'Retirer du Diaporama' : '✕ Rejeter la photo';
      }

      // Déterminer le format d'image (16:9 vs 9:16)
      const img = new Image();
      img.src = photo.image_url;
      img.onload = () => {
        const aspect = img.naturalWidth / img.naturalHeight;
        const isPortrait = aspect < 0.95;

        if (previewModalRatio) {
          previewModalRatio.textContent = isPortrait ? '📱 Format : 9:16 Portrait' : '💻 Format : 16:9 Paysage';
        }

        if (previewFormatTip) {
          if (isPortrait) {
            previewFormatTip.innerHTML = '✨ <strong>Photo Verticale (9:16)</strong> : Le shader la centre avec élégance et ajoute un <em>flou bokeh sombre</em> sur les côtés en vue Laptop.';
          } else {
            previewFormatTip.innerHTML = '✨ <strong>Photo Horizontale (16:9)</strong> : Remplissage parfait de l’écran sur Laptop, centrée sur Smartphone.';
          }
        }

        // Adapter le conteneur laptop : si portrait, ajouter la classe portrait pour le flou d'arrière-plan
        if (laptopImageHolder && laptopBgBlur) {
          if (isPortrait) {
            laptopImageHolder.classList.add('portrait-framed');
            laptopBgBlur.style.display = 'block';
          } else {
            laptopImageHolder.classList.remove('portrait-framed');
            laptopBgBlur.style.display = 'none';
          }
        }
      };

      // Mode Laptop par défaut
      setDeviceView('laptop');

      previewBackdrop.classList.add('open');
      previewBackdrop.setAttribute('aria-hidden', 'false');
    }

    function closePreviewModal() {
      if (!previewBackdrop) return;
      previewBackdrop.classList.remove('open');
      previewBackdrop.setAttribute('aria-hidden', 'true');
      currentPreviewPhoto = null;
    }

    function setDeviceView(device: 'laptop' | 'mobile') {
      if (device === 'laptop') {
        btnDeviceLaptop?.classList.add('active');
        btnDeviceMobile?.classList.remove('active');
        if (frameLaptop) frameLaptop.style.display = 'flex';
        if (frameMobile) frameMobile.style.display = 'none';
      } else {
        btnDeviceLaptop?.classList.remove('active');
        btnDeviceMobile?.classList.add('active');
        if (frameLaptop) frameLaptop.style.display = 'none';
        if (frameMobile) frameMobile.style.display = 'flex';
      }
    }

    btnDeviceLaptop?.addEventListener('click', () => setDeviceView('laptop'));
    btnDeviceMobile?.addEventListener('click', () => setDeviceView('mobile'));
    btnClosePreview?.addEventListener('click', closePreviewModal);

    previewBackdrop?.addEventListener('click', (e) => {
      if (e.target === previewBackdrop) closePreviewModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && previewBackdrop?.classList.contains('open')) {
        closePreviewModal();
      }
    });

    // Actions depuis la modale
    btnModalApprove?.addEventListener('click', async () => {
      if (currentPreviewPhoto) {
        btnModalApprove.textContent = 'Approbation...';
        btnModalApprove.disabled = true;
        await photoStore.approvePhoto(currentPreviewPhoto.id);
        closePreviewModal();
        await loadPhotos();
      }
    });

    btnModalReject?.addEventListener('click', async () => {
      if (currentPreviewPhoto && confirm('Voulez-vous retirer cette photographie ?')) {
        await photoStore.rejectPhoto(currentPreviewPhoto.id);
        closePreviewModal();
        await loadPhotos();
      }
    });

    // Gestion des onglets de statut
    statusTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        statusTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentStatusFilter = (tab.getAttribute('data-status') || 'pending') as any;
        renderCards();
      });
    });

    // Gestion du filtre par province
    provinceFilter?.addEventListener('change', () => {
      currentProvinceFilter = provinceFilter.value;
      renderCards();
    });

    // Authentification
    btnGoogle?.addEventListener('click', async () => {
      await photoStore.loginWithGoogle();
    });

    btnDemo?.addEventListener('click', async () => {
      await photoStore.loginAsGuest('Conservateur MVETT', 'alloghofrederic9@gmail.com');
      await checkAuth();
    });

    btnLogout?.addEventListener('click', async () => {
      await photoStore.logout();
      await checkAuth();
    });

    window.addEventListener('mvett:auth-changed', () => {
      checkAuth();
    });

    window.addEventListener('mvett:photos-updated', () => {
      loadPhotos();
    });

    checkAuth();
  });
</script>

