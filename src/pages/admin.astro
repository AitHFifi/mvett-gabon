    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .user-avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
  }

  .btn-logout {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    font-size: 0.75rem;
    margin-left: 0.2rem;
  }

  .btn-logout:hover {
    color: #ef4444;
  }

  /* Auth Gate */
  .admin-auth-gate {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  .gate-card {
    max-width: 500px;
    text-align: center;
    background: rgba(22, 28, 26, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    padding: 3rem 2.4rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .gate-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1.2rem;
  }

  .gate-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2.2rem;
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  .gate-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 2.2rem;
  }

  .gate-actions {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .btn-google-login {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
    padding: 0.85rem;
    background: #ffffff;
    color: #1a202c;
    border: none;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  .btn-google-login:hover {
    transform: translateY(-1px);
    background: #f1f5f9;
  }

  .btn-demo-admin {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #f8fafc;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.75rem;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-demo-admin:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Dashboard */
  .admin-dashboard {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 3rem 6rem 3rem;
  }

  /* Navigation Dual-Tab (Catalogue vs Modération) */
  .admin-view-nav {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 1rem;
  }

  .view-nav-tab {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.7);
    padding: 0.85rem 1.6rem;
    border-radius: 12px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .view-nav-tab:hover {
    background: rgba(255, 255, 255, 0.09);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .view-nav-tab.active {
    background: #ffffff;
    color: #0b0f0e;
    border-color: #ffffff;
    font-weight: 700;
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.15);
  }

  .tab-nav-badge {
    background: rgba(0, 0, 0, 0.2);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
  }

  .view-nav-tab.active .tab-nav-badge {
    background: #0b0f0e;
    color: #ffffff;
  }

  .tab-nav-badge.pending {
    background: #eab308;
    color: #000000;
  }

  /* Catalog Section Header */
  .catalog-section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 1.8rem;
    flex-wrap: wrap;
  }

  .section-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .section-subheading {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.65);
    max-width: 650px;
    line-height: 1.5;
  }

  .btn-add-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #22c55e;
    color: #05260f;
    border: none;
    padding: 0.8rem 1.4rem;
    border-radius: 12px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(34, 197, 94, 0.3);
    transition: all 0.2s ease;
  }

  .btn-add-primary:hover {
    background: #16a34a;
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(34, 197, 94, 0.45);
  }

  /* Catalog Toolbar */
  .catalog-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.8rem 1.2rem;
    border-radius: 14px;
  }

  .segmented-chips {
    display: flex;
    gap: 0.5rem;
  }

  .chip-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .chip-btn.active {
    background: #ffffff;
    color: #0d1110;
    border-color: #ffffff;
    font-weight: 600;
  }

  .chip-count {
    background: rgba(0, 0, 0, 0.25);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-size: 0.7rem;
  }

  .chip-btn.active .chip-count {
    background: rgba(0, 0, 0, 0.15);
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
  }

  .admin-select {
    padding: 0.55rem 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    outline: none;
    cursor: pointer;
  }

  .admin-select option {
    background: #141917;
    color: #ffffff;
  }

  /* Catalog Grid */
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 360px));
    justify-content: start;
    gap: 1.8rem;
  }

  @keyframes thumbShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .catalog-card {
    max-width: 360px;
    width: 100%;
    background: #141917;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .catalog-card:hover {
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-3px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6);
  }

  .catalog-card.archived {
    opacity: 0.65;
    filter: grayscale(0.2);
    border-left: 3px solid #64748b;
  }

  .catalog-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0f1412 linear-gradient(90deg, rgba(255,255,255,0.02) 25%, rgba(255,255,255,0.07) 50%, rgba(255,255,255,0.02) 75%);
    background-size: 200% 100%;
    animation: thumbShimmer 2.2s infinite ease-in-out;
    cursor: pointer;
  }

  .catalog-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s ease, transform 0.35s ease;
    display: block;
  }

  .catalog-thumb img.loaded {
    opacity: 1;
  }

  .catalog-thumb:hover img {
    transform: scale(1.05);
  }

  /* Fallback */
  .thumb-fallback {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background: #111715;
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    z-index: 1;
    text-align: center;
    padding: 1rem;
  }

  .catalog-thumb.has-error .thumb-fallback,
  .card-thumb.has-error .thumb-fallback {
    display: flex;
  }

  .catalog-thumb.has-error img,
  .card-thumb.has-error img {
    display: none !important;
  }

  .fallback-icon {
    font-size: 1.6rem;
    opacity: 0.75;
  }

  .fallback-text {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
  }

  .fallback-sub {
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.45);
  }

  /* Badge portrait 9:16 */
  .badge-portrait {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.88);
    backdrop-filter: blur(8px);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .badge-portrait.hidden {
    display: none !important;
  }

  .thumb-badges-top {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
  }

  .badge-prov {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .badge-order {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    color: #ffffff;
  }

  .thumb-badges-bottom {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.4rem;
    z-index: 2;
  }

  .badge-origin {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
  }

  .badge-origin.official {
    background: rgba(234, 179, 8, 0.85);
    color: #000000;
  }

  .badge-origin.community {
    background: rgba(59, 130, 246, 0.85);
    color: #ffffff;
  }

  .badge-archived {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: rgba(100, 116, 139, 0.85);
    color: #ffffff;
  }

  .thumb-overlay-hint {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .thumb-overlay-hint span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    background: #ffffff;
    color: #121615;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
  }

  .catalog-thumb:hover .thumb-overlay-hint {
    opacity: 1;
  }

  .catalog-card-body {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .catalog-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .catalog-title {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .color-swatch-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.5);
  }

  .catalog-location {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.7rem;
  }

  .catalog-caption {
    font-size: 0.8rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.4;
    margin-bottom: 0.9rem;
  }

  /* Contrôles d'ordre */
  .order-controls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    margin-top: auto;
    margin-bottom: 0.8rem;
  }

  .order-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.55);
    text-transform: uppercase;
  }

  .order-btns {
    display: flex;
    gap: 0.4rem;
  }

  .btn-order-move {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-order-move:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.35);
  }

  /* Barre d'actions */
  .catalog-actions-row {
    display: flex;
    gap: 0.45rem;
    align-items: center;
  }

  .btn-card-edit {
    flex: 1.2;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 0.5rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-card-edit:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .btn-card-test {
    flex: 1;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 0.5rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-card-test:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }

  .btn-card-archive {
    background: rgba(100, 116, 139, 0.2);
    color: #cbd5e1;
    border: 1px solid rgba(100, 116, 139, 0.4);
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-card-archive:hover {
    background: rgba(100, 116, 139, 0.35);
    color: #ffffff;
  }

  .btn-card-restore {
    background: rgba(34, 197, 94, 0.2);
    color: #86efac;
    border: 1px solid rgba(34, 197, 94, 0.4);
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-card-restore:hover {
    background: rgba(34, 197, 94, 0.35);
    color: #ffffff;
  }

  .btn-card-delete {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 0.5rem 0.65rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.76rem;
    transition: all 0.15s ease;
  }

  .btn-card-delete:hover {
    background: rgba(239, 68, 68, 0.3);
    color: #ffffff;
  }

  /* Modération CSS */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.4rem;
    margin-bottom: 2.2rem;
  }

  .kpi-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.4rem 1.6rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .kpi-card.highlight-pending {
    border-color: rgba(234, 179, 8, 0.35);
    background: rgba(234, 179, 8, 0.06);
  }

  .kpi-card.highlight-approved {
    border-color: rgba(34, 197, 94, 0.35);
    background: rgba(34, 197, 94, 0.06);
  }

  .kpi-icon {
    font-size: 1.8rem;
  }

  .kpi-data {
    display: flex;
    flex-direction: column;
  }

  .kpi-value {
    font-family: var(--font-mono);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .kpi-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.2rem;
  }

  .admin-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .status-tabs {
    display: flex;
    gap: 0.6rem;
  }

  .tab-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .tab-btn.active {
    background: #ffffff;
    color: #0f1412;
    border-color: #ffffff;
    font-weight: 600;
  }

  .tab-counter {
    background: rgba(0, 0, 0, 0.25);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-size: 0.72rem;
  }

  .submissions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 360px));
    justify-content: start;
    gap: 1.8rem;
  }

  .submission-card {
    max-width: 360px;
    width: 100%;
    background: #141917;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .submission-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6);
  }

  .submission-card.pending {
    border-left: 4px solid #eab308;
  }

  .submission-card.approved {
    border-left: 4px solid #22c55e;
  }

  .card-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0f1412 linear-gradient(90deg, rgba(255,255,255,0.02) 25%, rgba(255,255,255,0.07) 50%, rgba(255,255,255,0.02) 75%);
