        </div>

        <!-- Toolbar d'Actions du Studio -->
        <footer class="preview-modal-footer">
          <div class="footer-info">
            <p class="footer-tip" id="previewFormatTip">
              ℹ️ Ce cliché s'adaptera automatiquement selon l'appareil du visiteur.
            </p>
          </div>

          <div class="footer-buttons" id="previewModalButtons">
            <!-- Rempli dynamiquement selon si photo citoyenne ou officielle -->
          </div>
        </footer>

      </div>
    </div>

  </div>
</Layout>

<script>
  import { photoStore, type CommunityPhoto, type UserProfile, DEFAULT_BG_COLORS } from '../lib/photo-store';
  import { provinces } from '../data/provinces';
  import { compressImage, formatBytes } from '../lib/image-compressor';

  document.addEventListener('DOMContentLoaded', async () => {
    // Éléments généraux & Auth
    const authGate = document.getElementById('adminAuthGate');
    const dashboard = document.getElementById('adminDashboard');
    const userPill = document.getElementById('adminUserPill');
    const userAvatar = document.getElementById('adminUserAvatar') as HTMLImageElement | null;
    const userName = document.getElementById('adminUserName');
    const btnLogout = document.getElementById('adminBtnLogout');
    const btnGoogle = document.getElementById('btnAdminGoogle');

    // Navigation onglets principaux (Catalogue vs Modération)
    const tabNavCatalog = document.getElementById('tabNavCatalog');
    const tabNavModeration = document.getElementById('tabNavModeration');
    const sectionCatalog = document.getElementById('sectionCatalog');
    const sectionModeration = document.getElementById('sectionModeration');
    const badgeCatalogActiveCount = document.getElementById('badgeCatalogActiveCount');
    const badgeModerationPendingCount = document.getElementById('badgeModerationPendingCount');

    // Éléments Catalogue 3D
    const chipCatalogActive = document.getElementById('chipCatalogActive');
    const chipCatalogArchived = document.getElementById('chipCatalogArchived');
    const countCatalogActive = document.getElementById('countCatalogActive');
    const countCatalogArchived = document.getElementById('countCatalogArchived');
    const catalogProvinceFilter = document.getElementById('catalogProvinceFilter') as HTMLSelectElement | null;
    const catalogGrid = document.getElementById('catalogGrid');
    const catalogEmptyState = document.getElementById('catalogEmptyState');
    const btnOpenAddModal = document.getElementById('btnOpenAddModal');
    const btnEmptyAddPhoto = document.getElementById('btnEmptyAddPhoto');

    // Éléments Modération Citoyenne
    const countPending = document.getElementById('countPending');
    const countApproved = document.getElementById('countApproved');
    const countTotal = document.getElementById('countTotal');
    const tabPendingBadge = document.getElementById('tabPendingBadge');
    const tabApprovedBadge = document.getElementById('tabApprovedBadge');
    const statusTabs = document.querySelectorAll('[data-mod-status]');
    const moderationProvinceFilter = document.getElementById('adminProvinceFilter') as HTMLSelectElement | null;
    const submissionsGrid = document.getElementById('submissionsGrid');
    const moderationEmptyState = document.getElementById('adminEmptyState');

    // Éléments Modale d'Ajout
    const addModalBackdrop = document.getElementById('adminAddModalBackdrop');
    const btnCloseAddModal = document.getElementById('btnCloseAddModal');
    const btnCancelAddModal = document.getElementById('btnCancelAddModal');
    const adminAddForm = document.getElementById('adminAddForm') as HTMLFormElement | null;
    const addProvinceSelect = document.getElementById('addProvinceSelect') as HTMLSelectElement | null;
    const addTitleInput = document.getElementById('addTitleInput') as HTMLInputElement | null;
    const addLocationInput = document.getElementById('addLocationInput') as HTMLInputElement | null;
    const addCaptionInput = document.getElementById('addCaptionInput') as HTMLTextAreaElement | null;
    const addColorPresets = document.getElementById('addColorPresets');
    const addColorNativePicker = document.getElementById('addColorNativePicker') as HTMLInputElement | null;
    const addColorHexInput = document.getElementById('addColorHexInput') as HTMLInputElement | null;
    const btnSourceUrl = document.getElementById('btnSourceUrl');
    const btnSourceFile = document.getElementById('btnSourceFile');
    const panelSourceUrl = document.getElementById('panelSourceUrl');
    const panelSourceFile = document.getElementById('panelSourceFile');
    const addUrlInput = document.getElementById('addUrlInput') as HTMLInputElement | null;
    const addFileInput = document.getElementById('addFileInput') as HTMLInputElement | null;
    const addDropzone = document.getElementById('addDropzone');
    const addCompressionStatus = document.getElementById('addCompressionStatus');
    const addCompressionText = document.getElementById('addCompressionText');
    const addImagePreviewBox = document.getElementById('addImagePreviewBox');
    const addPreviewFrame = document.getElementById('addPreviewFrame');
    const addLiveImg = document.getElementById('addLiveImg') as HTMLImageElement | null;
    const btnSubmitAdd = document.getElementById('btnSubmitAdd') as HTMLButtonElement | null;

    // Éléments Modale d'Édition
    const editModalBackdrop = document.getElementById('adminEditModalBackdrop');
    const btnCloseEditModal = document.getElementById('btnCloseEditModal');
    const btnCancelEditModal = document.getElementById('btnCancelEditModal');
    const adminEditForm = document.getElementById('adminEditForm') as HTMLFormElement | null;
    const editPhotoId = document.getElementById('editPhotoId') as HTMLInputElement | null;
    const editProvinceSelect = document.getElementById('editProvinceSelect') as HTMLSelectElement | null;
    const editTitleInput = document.getElementById('editTitleInput') as HTMLInputElement | null;
    const editLocationInput = document.getElementById('editLocationInput') as HTMLInputElement | null;
    const editCaptionInput = document.getElementById('editCaptionInput') as HTMLTextAreaElement | null;
    const editColorPresets = document.getElementById('editColorPresets');
    const editColorNativePicker = document.getElementById('editColorNativePicker') as HTMLInputElement | null;
    const editColorHexInput = document.getElementById('editColorHexInput') as HTMLInputElement | null;
    const editCurrentImgThumb = document.getElementById('editCurrentImgThumb') as HTMLImageElement | null;
    const btnToggleReplaceImg = document.getElementById('btnToggleReplaceImg');
    const replaceImageDrawer = document.getElementById('replaceImageDrawer');
    const btnEditSourceUrl = document.getElementById('btnEditSourceUrl');
    const btnEditSourceFile = document.getElementById('btnEditSourceFile');
    const panelEditSourceUrl = document.getElementById('panelEditSourceUrl');
    const panelEditSourceFile = document.getElementById('panelEditSourceFile');
    const editUrlInput = document.getElementById('editUrlInput') as HTMLInputElement | null;
    const editFileInput = document.getElementById('editFileInput') as HTMLInputElement | null;
    const editCompressionStatus = document.getElementById('editCompressionStatus');
    const editCompressionText = document.getElementById('editCompressionText');
    const btnSubmitEdit = document.getElementById('btnSubmitEdit') as HTMLButtonElement | null;

    // Éléments Modale de Suppression / Archivage
    const deleteModalBackdrop = document.getElementById('adminDeleteModalBackdrop');
    const btnCloseDeleteModal = document.getElementById('btnCloseDeleteModal');
    const btnCancelDeleteModal = document.getElementById('btnCancelDeleteModal');
    const deleteModalThumb = document.getElementById('deleteModalThumb') as HTMLImageElement | null;
    const deleteModalTitleText = document.getElementById('deleteModalTitleText');
    const deleteModalLocText = document.getElementById('deleteModalLocText');
    const btnChoiceArchive = document.getElementById('btnChoiceArchive');
    const btnChoicePermanent = document.getElementById('btnChoicePermanent');

    // Éléments Studio de Prévisualisation
    const previewBackdrop = document.getElementById('previewModalBackdrop');
    const btnClosePreview = document.getElementById('btnClosePreviewModal');
    const previewModalProvince = document.getElementById('previewModalProvince');
    const previewModalRatio = document.getElementById('previewModalRatio');
    const previewModalStatus = document.getElementById('previewModalStatus');
    const previewModalTitle = document.getElementById('previewModalTitle');
    const previewModalLocation = document.getElementById('previewModalLocation');
    const btnDeviceLaptop = document.getElementById('btnDeviceLaptop');
    const btnDeviceMobile = document.getElementById('btnDeviceMobile');
    const frameLaptop = document.getElementById('frameLaptop');
    const frameMobile = document.getElementById('frameMobile');
    const laptopMainImg = document.getElementById('laptopMainImg') as HTMLImageElement | null;
    const laptopBgBlur = document.getElementById('laptopBgBlur');
    const laptopImageHolder = document.getElementById('laptopImageHolder');
    const laptopMockCounter = document.getElementById('laptopMockCounter');
    const laptopMockTitle = document.getElementById('laptopMockTitle');
    const laptopMockLoc = document.getElementById('laptopMockLoc');
    const mobileMainImg = document.getElementById('mobileMainImg') as HTMLImageElement | null;
    const mobileMockTitle = document.getElementById('mobileMockTitle');
    const mobileMockLoc = document.getElementById('mobileMockLoc');
    const previewFormatTip = document.getElementById('previewFormatTip');
    const previewModalButtons = document.getElementById('previewModalButtons');

    // État local de l'application
    let currentMainTab: 'catalog' | 'moderation' = 'catalog';
    let currentCatalogStatus: 'active' | 'archived' = 'active';
    let currentCatalogProvince: string = 'all';
    let currentModStatus: 'pending' | 'approved' | 'all' = 'pending';
    let currentModProvince: string = 'all';

    let currentUser: UserProfile | null = null;
    let allCatalogPhotos: CommunityPhoto[] = [];
    let allModerationPhotos: CommunityPhoto[] = [];
    let currentPreviewPhoto: CommunityPhoto | null = null;
    let pendingDeletePhoto: CommunityPhoto | null = null;

    // Fichiers compressés en cache pour upload
    let addCompressedFile: File | null = null;
    let editCompressedFile: File | null = null;
    let addImageMode: 'url' | 'file' = 'url';
    let editImageMode: 'url' | 'file' = 'url';

    // Initialiser les swatches de couleurs
    function initColorPickers() {
      renderSwatches(addColorPresets, addColorNativePicker, addColorHexInput, (color) => {
        if (addPreviewFrame) addPreviewFrame.style.backgroundColor = color;
      });
      renderSwatches(editColorPresets, editColorNativePicker, editColorHexInput);
    }

    function renderSwatches(
      container: HTMLElement | null,
      nativeInput: HTMLInputElement | null,
      hexInput: HTMLInputElement | null,
      onChange?: (c: string) => void
    ) {
      if (!container || !nativeInput || !hexInput) return;
      container.innerHTML = DEFAULT_BG_COLORS.map((c) => `
        <button type="button" class="swatch-btn ${c === nativeInput.value ? 'selected' : ''}" style="background-color: ${c};" data-color="${c}" title="${c}"></button>
      `).join('');

      container.querySelectorAll('.swatch-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const col = (btn as HTMLElement).getAttribute('data-color');
          if (col) {
            nativeInput.value = col;
            hexInput.value = col;
            container.querySelectorAll('.swatch-btn').forEach((b) => b.classList.remove('selected'));
            btn.classList.add('selected');
            if (onChange) onChange(col);
          }
        });
      });

      nativeInput.addEventListener('input', () => {
        hexInput.value = nativeInput.value;
        if (onChange) onChange(nativeInput.value);
      });

      hexInput.addEventListener('input', () => {
        if (/^#[0-9A-Fa-f]{6}$/.test(hexInput.value)) {
          nativeInput.value = hexInput.value;
          if (onChange) onChange(hexInput.value);
        }
      });
    }

    // ==========================================
    // AUTHENTIFICATION & CONTRÔLE D'ACCÈS STRICT
    // ==========================================
    async function checkAuth() {
      currentUser = await photoStore.getCurrentUser();

      // Si un utilisateur est connecté mais n'est pas l'administrateur autorisé :
      // Déconnexion immédiate et redirection vers la page d'accueil avec alerte.
      if (currentUser && !photoStore.isAdmin(currentUser)) {
        await photoStore.logout();
        window.location.replace('/?auth_error=unauthorized');
        return;
      }

      renderAuthUI();

      if (currentUser && photoStore.isAdmin(currentUser)) {
        await reloadAllData();
      }
    }

    function renderAuthUI() {
      const isAdmin = !!(currentUser && photoStore.isAdmin(currentUser));

      if (isAdmin) {
        if (authGate) authGate.style.display = 'none';
        if (dashboard) dashboard.style.display = 'block';
        if (userPill) userPill.style.display = 'inline-flex';
        if (userName) userName.textContent = `${currentUser?.name} (Admin)`;
        if (userAvatar && currentUser?.avatar) userAvatar.src = currentUser.avatar;
      } else {
        if (authGate) authGate.style.display = 'flex';
        if (dashboard) dashboard.style.display = 'none';
        if (userPill) userPill.style.display = 'none';
      }
    }

    async function reloadAllData() {
      if (!currentUser || !photoStore.isAdmin(currentUser)) {
        window.location.replace('/?auth_error=unauthorized');
        return;
      }

      // 1. Charger tout le catalogue (y compris archivées)
      allCatalogPhotos = await photoStore.getCatalogPhotos({ includeArchived: true });
      // 2. Charger les photos de modération
      allModerationPhotos = await photoStore.getPhotos({ status: 'all' });

      updateCounters();
      renderCatalogView();
      renderModerationView();
    }

    function updateCounters() {
      const activeList = allCatalogPhotos.filter((p) => p.status === 'approved');
      const archivedList = allCatalogPhotos.filter((p) => p.status === 'archived');
      const pendingList = allModerationPhotos.filter((p) => p.status === 'pending');
      const approvedModList = allModerationPhotos.filter((p) => p.status === 'approved');

      if (badgeCatalogActiveCount) badgeCatalogActiveCount.textContent = String(activeList.length);
      if (countCatalogActive) countCatalogActive.textContent = String(activeList.length);
      if (countCatalogArchived) countCatalogArchived.textContent = String(archivedList.length);

      if (badgeModerationPendingCount) badgeModerationPendingCount.textContent = String(pendingList.length);
      if (countPending) countPending.textContent = String(pendingList.length);
      if (countApproved) countApproved.textContent = String(approvedModList.length);
      if (countTotal) countTotal.textContent = String(allModerationPhotos.length);
      if (tabPendingBadge) tabPendingBadge.textContent = String(pendingList.length);
      if (tabApprovedBadge) tabApprovedBadge.textContent = String(approvedModList.length);
    }

    // ==========================================
    // BASCULE D'ONGLETS PRINCIPAUX
    // ==========================================
    function setMainTab(tab: 'catalog' | 'moderation') {
      currentMainTab = tab;
      if (tab === 'catalog') {
        tabNavCatalog?.classList.add('active');
        tabNavModeration?.classList.remove('active');
        if (sectionCatalog) sectionCatalog.style.display = 'block';
        if (sectionModeration) sectionModeration.style.display = 'none';
      } else {
        tabNavCatalog?.classList.remove('active');
        tabNavModeration?.classList.add('active');
        if (sectionCatalog) sectionCatalog.style.display = 'none';
        if (sectionModeration) sectionModeration.style.display = 'block';
      }
    }

    tabNavCatalog?.addEventListener('click', () => setMainTab('catalog'));
    tabNavModeration?.addEventListener('click', () => setMainTab('moderation'));

    // ==========================================
    // RENDU DU CATALOGUE 3D
    // ==========================================
    function renderCatalogView() {
      if (!catalogGrid || !catalogEmptyState) return;

      // Filtrer par statut (actif / archivé)
      let filtered = allCatalogPhotos.filter((p) => {
        if (currentCatalogStatus === 'active') return p.status === 'approved';
        return p.status === 'archived';
      });

      // Filtrer par province
      if (currentCatalogProvince !== 'all') {
        filtered = filtered.filter((p) => p.province_id === currentCatalogProvince);
      }

      if (filtered.length === 0) {
        catalogGrid.innerHTML = '';
        catalogEmptyState.style.display = 'flex';
        return;
      }

      catalogEmptyState.style.display = 'none';

      // Grouper par province pour un réordonnancement clair
      catalogGrid.innerHTML = filtered.map((photo) => {
        const prov = provinces.find((p) => p.id === photo.province_id);
        const provName = prov ? `${prov.code} · ${prov.name}` : photo.province_id;
        const isOfficial = photo.is_official !== false;
        const isArchived = photo.status === 'archived';
        const displayOrder = (photo.display_order ?? 0) + 1;

        return `
          <article class="catalog-card ${isArchived ? 'archived' : ''}" data-photo-id="${photo.id}">
            <div class="catalog-thumb" data-preview-id="${photo.id}" title="Cliquer pour tester dans le simulateur 3D">
              <img 
                src="${photo.image_url}" 
                alt="${photo.title}" 
                loading="lazy" 
                class="thumb-img" 
                onload="this.classList.add('loaded'); if (this.naturalHeight > this.naturalWidth) this.closest('.catalog-thumb')?.querySelector('.badge-portrait')?.classList.remove('hidden');" 
                onerror="this.onerror=null; this.closest('.catalog-thumb')?.classList.add('has-error');" 
              />
              
              <div class="thumb-badges-top">
                <span class="badge-prov">${provName}</span>
                <span class="badge-order">#${displayOrder}</span>
                <span class="badge-portrait hidden" title="Format vertical (9:16) - Adaptatif 3D">📱 9:16</span>
              </div>

              <div class="thumb-badges-bottom">
                <span class="badge-origin ${isOfficial ? 'official' : 'community'}">
                  ${isOfficial ? '★ Officielle' : '👥 Citoyenne'}
                </span>
                ${isArchived ? '<span class="badge-archived">📦 Archivée</span>' : ''}
              </div>

              <div class="thumb-fallback">
                <span class="fallback-icon">📷</span>
                <span class="fallback-text">Image non disponible</span>
                <span class="fallback-sub">${provName}</span>
              </div>

              <div class="thumb-overlay-hint">
                <span>👁 Tester 3D</span>
              </div>
            </div>

            <div class="catalog-card-body">
              <div class="catalog-title-row">
                <h3 class="catalog-title">${photo.title}</h3>
                <span class="color-swatch-dot" style="background-color: ${photo.background_color};" title="Fond d'ambiance 3D : ${photo.background_color}"></span>
              </div>

              <p class="catalog-location">${photo.location}</p>
              ${photo.caption ? `<p class="catalog-caption">« ${photo.caption} »</p>` : ''}

              <!-- Barre d'ajustement d'ordre de diffusion -->
              ${!isArchived ? `
                <div class="order-controls-row">
                  <span class="order-label">Ordre province :</span>
                  <div class="order-btns">
                    <button type="button" class="btn-order-move" data-move-up="${photo.id}" title="Déplacer vers l'avant dans cette province">
                      ▲ Monter
                    </button>
                    <button type="button" class="btn-order-move" data-move-down="${photo.id}" title="Déplacer vers l'arrière dans cette province">
                      ▼ Descendre
                    </button>
                  </div>
                </div>
              ` : ''}

              <!-- Barre d'actions d'édition et suppression -->
              <div class="catalog-actions-row">
                <button type="button" class="btn-card-edit" data-edit-id="${photo.id}">
                  ✏️ Modifier
                </button>
                <button type="button" class="btn-card-test" data-preview-id="${photo.id}" title="Prévisualiser sur Laptop & Mobile">
                  👁 Tester
                </button>

                ${!isArchived ? `
                  <button type="button" class="btn-card-archive" data-archive-id="${photo.id}" title="Masquer du diaporama">
                    📦 Archiver
                  </button>
                ` : `
                  <button type="button" class="btn-card-restore" data-restore-id="${photo.id}" title="Remettre dans le diaporama 3D">
                    ↺ Restaurer
                  </button>
                `}

                <button type="button" class="btn-card-delete" data-delete-id="${photo.id}" title="Supprimer">
                  🗑️
                </button>
              </div>
            </div>
          </article>
        `;
      }).join('');

      // Attacher les écouteurs du catalogue
      // 1. Prévisualisation 3D
      catalogGrid.querySelectorAll('[data-preview-id]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const pId = (el as HTMLElement).getAttribute('data-preview-id');
          if (pId) {
            const photo = allCatalogPhotos.find((p) => p.id === pId);
            if (photo) openPreviewModal(photo);
          }
        });
      });

      // 2. Réordonnancement Monter (Up)
      catalogGrid.querySelectorAll('[data-move-up]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-move-up');
          if (!pId) return;
          const target = allCatalogPhotos.find((p) => p.id === pId);
          if (!target) return;

          // Obtenir toutes les photos actives de cette province dans l'ordre actuel
          const provPhotos = allCatalogPhotos.filter((p) => p.province_id === target.province_id && p.status === 'approved');
          const currIdx = provPhotos.findIndex((p) => p.id === pId);
          if (currIdx > 0) {
            // Échanger avec la précédente
            const temp = provPhotos[currIdx];
            provPhotos[currIdx] = provPhotos[currIdx - 1];
            provPhotos[currIdx - 1] = temp;
            await photoStore.reorderCatalogPhotos(target.province_id, provPhotos.map((p) => p.id));
            await reloadAllData();
          }
        });
      });

      // 3. Réordonnancement Descendre (Down)
      catalogGrid.querySelectorAll('[data-move-down]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-move-down');
          if (!pId) return;
          const target = allCatalogPhotos.find((p) => p.id === pId);
          if (!target) return;

          const provPhotos = allCatalogPhotos.filter((p) => p.province_id === target.province_id && p.status === 'approved');
          const currIdx = provPhotos.findIndex((p) => p.id === pId);
          if (currIdx !== -1 && currIdx < provPhotos.length - 1) {
            // Échanger avec la suivante
            const temp = provPhotos[currIdx];
            provPhotos[currIdx] = provPhotos[currIdx + 1];
            provPhotos[currIdx + 1] = temp;
            await photoStore.reorderCatalogPhotos(target.province_id, provPhotos.map((p) => p.id));
            await reloadAllData();
          }
        });
      });

      // 4. Éditer
      catalogGrid.querySelectorAll('[data-edit-id]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-edit-id');
          if (pId) {
            const photo = allCatalogPhotos.find((p) => p.id === pId);
            if (photo) openEditModal(photo);
          }
        });
      });

      // 5. Archiver
      catalogGrid.querySelectorAll('[data-archive-id]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-archive-id');
          if (pId) {
            await photoStore.archiveCatalogPhoto(pId);
            await reloadAllData();
          }
        });
      });

      // 6. Restaurer
      catalogGrid.querySelectorAll('[data-restore-id]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-restore-id');
          if (pId) {
            await photoStore.restoreCatalogPhoto(pId);
            await reloadAllData();
          }
        });
      });

      // 7. Supprimer (ouvre le dialogue)
      catalogGrid.querySelectorAll('[data-delete-id]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-delete-id');
          if (pId) {
            const photo = allCatalogPhotos.find((p) => p.id === pId);
            if (photo) openDeleteModal(photo);
          }
        });
      });
    }

    // Filtres du Catalogue
    chipCatalogActive?.addEventListener('click', () => {
      chipCatalogActive.classList.add('active');
      chipCatalogArchived?.classList.remove('active');
      currentCatalogStatus = 'active';
      renderCatalogView();
    });

    chipCatalogArchived?.addEventListener('click', () => {
      chipCatalogArchived.classList.add('active');
      chipCatalogActive?.classList.remove('active');
      currentCatalogStatus = 'archived';
      renderCatalogView();
    });

    catalogProvinceFilter?.addEventListener('change', () => {
      currentCatalogProvince = catalogProvinceFilter.value;
      renderCatalogView();
    });


    // ==========================================
    // RENDU DE LA MODÉRATION CITOYENNE
    // ==========================================
    function renderModerationView() {
      if (!submissionsGrid || !moderationEmptyState) return;

      let filtered = allModerationPhotos;
      if (currentModStatus !== 'all') {
        filtered = filtered.filter((p) => p.status === currentModStatus);
      }
      if (currentModProvince !== 'all') {
        filtered = filtered.filter((p) => p.province_id === currentModProvince);
      }

      if (filtered.length === 0) {
        submissionsGrid.innerHTML = '';
        moderationEmptyState.style.display = 'flex';
        return;
      }

      moderationEmptyState.style.display = 'none';

      submissionsGrid.innerHTML = filtered.map((photo) => {
        const prov = provinces.find((p) => p.id === photo.province_id);
        const provName = prov ? `${prov.code} · ${prov.name}` : photo.province_id;
        const dateStr = new Date(photo.created_at).toLocaleDateString('fr-FR', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        });
        const isApproved = photo.status === 'approved';
        const isPending = photo.status === 'pending';

        return `
          <article class="submission-card ${photo.status}" data-photo-id="${photo.id}">
            <div class="card-thumb" data-preview-id="${photo.id}" title="Cliquer pour prévisualiser">
              <img 
                src="${photo.image_url}" 
                alt="${photo.title}" 
                loading="lazy" 
                class="thumb-img" 
                onload="this.classList.add('loaded'); if (this.naturalHeight > this.naturalWidth) this.closest('.card-thumb')?.querySelector('.badge-portrait')?.classList.remove('hidden');" 
                onerror="this.onerror=null; this.closest('.card-thumb')?.classList.add('has-error');" 
              />
              <div class="card-status-badge ${photo.status}">
                ${isApproved ? '✓ Approuvée' : isPending ? '⏳ En Attente' : '✕ Rejetée'}
              </div>
              <span class="card-province-badge">${provName}</span>
              <span class="badge-portrait hidden" title="Format vertical (9:16)">📱 9:16</span>
              <div class="thumb-fallback">
                <span class="fallback-icon">📷</span>
                <span class="fallback-text">Image non disponible</span>
              </div>
              <div class="thumb-overlay-hint">
                <span>👁 Prévisualiser</span>
              </div>
            </div>

            <div class="card-body">
              <div class="card-top">
                <h3 class="card-title">${photo.title}</h3>
                <p class="card-location">${photo.location}</p>
              </div>

              ${photo.caption ? `<p class="card-caption">« ${photo.caption} »</p>` : '<p class="card-caption empty">Aucune légende</p>'}

              <div class="card-contributor">
                ${photo.user_avatar ? `<img src="${photo.user_avatar}" class="contributor-avatar" alt="" />` : `<span class="contributor-initial">${photo.user_name.charAt(0)}</span>`}
                <div class="contributor-meta">
                  <span class="contributor-name">${photo.user_name}</span>
                  <span class="submission-date">${dateStr}</span>
                </div>
              </div>

              <button type="button" class="btn-card-preview" data-preview-id="${photo.id}">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <span>Tester Laptop & Mobile</span>
              </button>

              <div class="card-actions">
                ${!isApproved ? `
                  <button type="button" class="btn-action-approve" data-approve-id="${photo.id}">
                    ✓ Approuver
                  </button>
                ` : `
                  <a href="/?photo=${photo.id}" class="btn-action-view" target="_blank">
                    👁 Diaporama ↗
                  </a>
                `}

                <button type="button" class="btn-action-reject" data-reject-id="${photo.id}" title="Rejeter et retirer">
                  ${isApproved ? 'Retirer' : 'Rejeter'}
                </button>
              </div>
            </div>
          </article>
        `;
      }).join('');

      // Actions de modération
      submissionsGrid.querySelectorAll('[data-preview-id]').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const pId = (el as HTMLElement).getAttribute('data-preview-id');
          if (pId) {
            const photo = allModerationPhotos.find((p) => p.id === pId);
            if (photo) openPreviewModal(photo);
          }
        });
      });

      submissionsGrid.querySelectorAll('.btn-action-approve').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-approve-id');
          if (pId) {
            btn.textContent = 'Approbation...';
            (btn as HTMLButtonElement).disabled = true;
            await photoStore.approvePhoto(pId);
            await reloadAllData();
          }
        });
      });

      submissionsGrid.querySelectorAll('.btn-action-reject').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const pId = (btn as HTMLElement).getAttribute('data-reject-id');
          if (pId && confirm('Voulez-vous rejeter cette photographie citoyenne ?')) {
            await photoStore.rejectPhoto(pId);
            await reloadAllData();
          }
        });
      });
    }

    statusTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        statusTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentModStatus = (tab.getAttribute('data-mod-status') || 'pending') as any;
        renderModerationView();
      });
    });

    moderationProvinceFilter?.addEventListener('change', () => {
      currentModProvince = moderationProvinceFilter.value;
      renderModerationView();
    });


    // ==========================================
    // MODALE D'AJOUT D'UNE PHOTO
    // ==========================================
    function openAddModal() {
      if (!addModalBackdrop) return;
      if (adminAddForm) adminAddForm.reset();
      addCompressedFile = null;
      setAddImageSource('url');
      if (addImagePreviewBox) addImagePreviewBox.style.display = 'none';
      if (addCompressionStatus) addCompressionStatus.style.display = 'none';

      // Couleur par défaut
      const defColor = DEFAULT_BG_COLORS[0];
      if (addColorNativePicker) addColorNativePicker.value = defColor;
      if (addColorHexInput) addColorHexInput.value = defColor;
      if (addPreviewFrame) addPreviewFrame.style.backgroundColor = defColor;

      addModalBackdrop.classList.add('open');
      addModalBackdrop.setAttribute('aria-hidden', 'false');
    }

    function closeAddModal() {
      if (!addModalBackdrop) return;
      addModalBackdrop.classList.remove('open');
      addModalBackdrop.setAttribute('aria-hidden', 'true');
    }

    function setAddImageSource(mode: 'url' | 'file') {
      addImageMode = mode;
      if (mode === 'url') {
        btnSourceUrl?.classList.add('active');
        btnSourceFile?.classList.remove('active');
        if (panelSourceUrl) panelSourceUrl.style.display = 'block';
        if (panelSourceFile) panelSourceFile.style.display = 'none';
      } else {
        btnSourceFile?.classList.add('active');
        btnSourceUrl?.classList.remove('active');
        if (panelSourceFile) panelSourceFile.style.display = 'block';
        if (panelSourceUrl) panelSourceUrl.style.display = 'none';
      }
    }

    btnSourceUrl?.addEventListener('click', () => setAddImageSource('url'));
    btnSourceFile?.addEventListener('click', () => setAddImageSource('file'));
    btnOpenAddModal?.addEventListener('click', openAddModal);
    btnEmptyAddPhoto?.addEventListener('click', openAddModal);
    btnCloseAddModal?.addEventListener('click', closeAddModal);
    btnCancelAddModal?.addEventListener('click', closeAddModal);

    // Prévisualisation en direct pour l'URL
    addUrlInput?.addEventListener('input', () => {
      const url = addUrlInput.value.trim();
      if (url && addLiveImg && addImagePreviewBox) {
        addLiveImg.src = url;
        addImagePreviewBox.style.display = 'block';
      }
    });

    // Gestion du fichier avec compression WebP
    addFileInput?.addEventListener('change', async () => {
      const file = addFileInput.files?.[0];
      if (!file) return;

      if (addCompressionStatus && addCompressionText) {
        addCompressionStatus.style.display = 'flex';
        addCompressionText.textContent = 'Optimisation WebP haute fidélité...';
      }

      try {
        const result = await compressImage(file);
        addCompressedFile = result.file;
        if (addLiveImg && addImagePreviewBox) {
          addLiveImg.src = result.previewUrl;
          addImagePreviewBox.style.display = 'block';
        }
        if (addCompressionText) {
          addCompressionText.textContent = `Optimisé : ${formatBytes(result.originalSize)} → ${formatBytes(result.compressedSize)} (-${result.ratioPercent}%)`;
        }
      } catch (err) {
        console.error('Erreur compression', err);
        addCompressedFile = file;
      }
    });

    adminAddForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!photoStore.isAdmin(currentUser)) {
        window.location.replace('/?auth_error=unauthorized');
        return;
      }
      if (!addProvinceSelect || !addTitleInput || !addLocationInput) return;

      const provinceId = addProvinceSelect.value;
      const title = addTitleInput.value.trim();
      const location = addLocationInput.value.trim();
      const caption = addCaptionInput?.value.trim() || '';
      const bgColor = addColorHexInput?.value.trim() || DEFAULT_BG_COLORS[0];
      const imageUrl = addUrlInput?.value.trim();

      if (addImageMode === 'url' && !imageUrl) {
        alert('Veuillez entrer une adresse URL valide pour l’image.');
        return;
      }
      if (addImageMode === 'file' && !addCompressedFile) {
        alert('Veuillez sélectionner un fichier image.');
        return;
      }

      if (btnSubmitAdd) {
        btnSubmitAdd.disabled = true;
        btnSubmitAdd.textContent = 'Publication en cours...';
      }

      try {
        const res = await photoStore.createCatalogPhoto({
          provinceId,
          title,
          location,
          caption,
          backgroundColor: bgColor,
          imageUrl: addImageMode === 'url' ? imageUrl : undefined,
          file: addImageMode === 'file' && addCompressedFile ? addCompressedFile : undefined,
        });

        if (res.error) {
          alert(`Erreur : ${res.error}`);
        } else {
          closeAddModal();
          await reloadAllData();
        }
      } catch (err: unknown) {
        alert(`Erreur lors de l'ajout : ${err}`);
      } finally {
        if (btnSubmitAdd) {
          btnSubmitAdd.disabled = false;
          btnSubmitAdd.textContent = '✓ Publier immédiatement dans le Diaporama 3D';
        }
      }
    });


    // ==========================================
    // MODALE D'ÉDITION D'UNE PHOTO
    // ==========================================
    function openEditModal(photo: CommunityPhoto) {
      if (!editModalBackdrop) return;
      if (adminEditForm) adminEditForm.reset();
      editCompressedFile = null;
      if (replaceImageDrawer) replaceImageDrawer.style.display = 'none';
      if (editCompressionStatus) editCompressionStatus.style.display = 'none';

      if (editPhotoId) editPhotoId.value = photo.id;
      if (editProvinceSelect) editProvinceSelect.value = photo.province_id;
      if (editTitleInput) editTitleInput.value = photo.title;
      if (editLocationInput) editLocationInput.value = photo.location;
      if (editCaptionInput) editCaptionInput.value = photo.caption || '';
      if (editColorNativePicker) editColorNativePicker.value = photo.background_color;
      if (editColorHexInput) editColorHexInput.value = photo.background_color;
      if (editCurrentImgThumb) editCurrentImgThumb.src = photo.image_url;

      renderSwatches(editColorPresets, editColorNativePicker, editColorHexInput);

      editModalBackdrop.classList.add('open');
      editModalBackdrop.setAttribute('aria-hidden', 'false');
    }

    function closeEditModal() {
      if (!editModalBackdrop) return;
      editModalBackdrop.classList.remove('open');
      editModalBackdrop.setAttribute('aria-hidden', 'true');
    }

    btnToggleReplaceImg?.addEventListener('click', () => {
      if (!replaceImageDrawer) return;
      const isOpen = replaceImageDrawer.style.display !== 'none';
      replaceImageDrawer.style.display = isOpen ? 'none' : 'block';
    });

    function setEditImageSource(mode: 'url' | 'file') {
      editImageMode = mode;
      if (mode === 'url') {
        btnEditSourceUrl?.classList.add('active');
        btnEditSourceFile?.classList.remove('active');
        if (panelEditSourceUrl) panelEditSourceUrl.style.display = 'block';
        if (panelEditSourceFile) panelEditSourceFile.style.display = 'none';
      } else {
        btnEditSourceFile?.classList.add('active');
        btnEditSourceUrl?.classList.remove('active');
        if (panelEditSourceFile) panelEditSourceFile.style.display = 'block';
        if (panelEditSourceUrl) panelEditSourceUrl.style.display = 'none';
      }
    }

    btnEditSourceUrl?.addEventListener('click', () => setEditImageSource('url'));
    btnEditSourceFile?.addEventListener('click', () => setEditImageSource('file'));
    btnCloseEditModal?.addEventListener('click', closeEditModal);
    btnCancelEditModal?.addEventListener('click', closeEditModal);

    editFileInput?.addEventListener('change', async () => {
      const file = editFileInput.files?.[0];
      if (!file) return;

      if (editCompressionStatus && editCompressionText) {
        editCompressionStatus.style.display = 'flex';
        editCompressionText.textContent = 'Optimisation...';
      }

      try {
        const result = await compressImage(file);
        editCompressedFile = result.file;
        if (editCurrentImgThumb) editCurrentImgThumb.src = result.previewUrl;
        if (editCompressionText) {
          editCompressionText.textContent = `Optimisé : ${formatBytes(result.originalSize)} → ${formatBytes(result.compressedSize)} (-${result.ratioPercent}%)`;
        }
      } catch (err) {
        editCompressedFile = file;
      }
    });

    adminEditForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!photoStore.isAdmin(currentUser)) {
        window.location.replace('/?auth_error=unauthorized');
        return;
      }
      const pId = editPhotoId?.value;
      if (!pId) return;

      const title = editTitleInput?.value.trim();
      const location = editLocationInput?.value.trim();
      const caption = editCaptionInput?.value.trim();
      const provinceId = editProvinceSelect?.value;
      const backgroundColor = editColorHexInput?.value.trim();

      const isReplacing = replaceImageDrawer && replaceImageDrawer.style.display !== 'none';
      const newUrl = isReplacing && editImageMode === 'url' ? editUrlInput?.value.trim() : undefined;
      const newFile = isReplacing && editImageMode === 'file' && editCompressedFile ? editCompressedFile : undefined;

      if (btnSubmitEdit) {
        btnSubmitEdit.disabled = true;
        btnSubmitEdit.textContent = 'Enregistrement...';
      }

      try {
        const res = await photoStore.updateCatalogPhoto(pId, {
          title,
          location,
          caption,
          provinceId,
          backgroundColor,
          imageUrl: newUrl,
          file: newFile,
        });

        if (res.error) {
          alert(`Erreur : ${res.error}`);
        } else {
          closeEditModal();
          await reloadAllData();
        }
      } catch (err: unknown) {
        alert(`Erreur lors de la mise à jour : ${err}`);
      } finally {
        if (btnSubmitEdit) {
          btnSubmitEdit.disabled = false;
          btnSubmitEdit.textContent = '💾 Enregistrer les Modifications';
        }
      }
    });


    // ==========================================
    // MODALE DE SUPPRESSION / ARCHIVAGE
    // ==========================================
    function openDeleteModal(photo: CommunityPhoto) {
      if (!deleteModalBackdrop) return;
      pendingDeletePhoto = photo;

      if (deleteModalThumb) deleteModalThumb.src = photo.image_url;
      if (deleteModalTitleText) deleteModalTitleText.textContent = photo.title;
      if (deleteModalLocText) deleteModalLocText.textContent = photo.location;

      deleteModalBackdrop.classList.add('open');
      deleteModalBackdrop.setAttribute('aria-hidden', 'false');
    }

    function closeDeleteModal() {
      if (!deleteModalBackdrop) return;
      deleteModalBackdrop.classList.remove('open');
      deleteModalBackdrop.setAttribute('aria-hidden', 'true');
      pendingDeletePhoto = null;
    }

    btnCloseDeleteModal?.addEventListener('click', closeDeleteModal);
    btnCancelDeleteModal?.addEventListener('click', closeDeleteModal);

    btnChoiceArchive?.addEventListener('click', async () => {
      if (!pendingDeletePhoto) return;
      await photoStore.archiveCatalogPhoto(pendingDeletePhoto.id);
      closeDeleteModal();
      await reloadAllData();
    });

    btnChoicePermanent?.addEventListener('click', async () => {
      if (!pendingDeletePhoto) return;
      if (confirm(`Êtes-vous absolument sûr de vouloir supprimer définitivement "${pendingDeletePhoto.title}" ? Cette action est irréversible.`)) {
        await photoStore.deletePhoto(pendingDeletePhoto.id, true);
        closeDeleteModal();
        await reloadAllData();
      }
    });


    // ==========================================
    // STUDIO DE PRÉVISUALISATION (MULTI-ÉCRANS)
    // ==========================================
    function openPreviewModal(photo: CommunityPhoto) {
      if (!previewBackdrop) return;
      currentPreviewPhoto = photo;

      const prov = provinces.find((p) => p.id === photo.province_id);
      const provName = prov ? `${prov.code} · ${prov.name}` : photo.province_id;

      if (previewModalProvince) previewModalProvince.textContent = provName;
      if (previewModalTitle) previewModalTitle.textContent = photo.title;
      if (previewModalLocation) previewModalLocation.textContent = `${photo.location} — ${photo.is_official !== false ? 'Patrimoine MVETT' : 'par ' + photo.user_name}`;
      
      if (previewModalStatus) {
        previewModalStatus.textContent = photo.status === 'approved' ? '✓ Diffusée en 3D' : photo.status === 'archived' ? '📦 Archivée' : '⏳ En attente';
        previewModalStatus.className = `preview-badge-status ${photo.status}`;
      }

      if (laptopMainImg) laptopMainImg.src = photo.image_url;
      if (laptopBgBlur) laptopBgBlur.style.backgroundImage = `url("${photo.image_url}")`;
      if (laptopMockCounter) laptopMockCounter.textContent = `01 / 03 · ${prov ? prov.code : 'G1'} ${(prov ? prov.name : 'GABON').toUpperCase()}`;
      if (laptopMockTitle) laptopMockTitle.textContent = photo.title;
      if (laptopMockLoc) laptopMockLoc.textContent = photo.location;

      if (mobileMainImg) mobileMainImg.src = photo.image_url;
      if (mobileMockTitle) mobileMockTitle.textContent = photo.title;
      if (mobileMockLoc) mobileMockLoc.textContent = photo.location;

      // Boutons dynamiques du studio
      if (previewModalButtons) {
        if (photo.is_official !== false || photo.status === 'approved') {
          previewModalButtons.innerHTML = `
            <button type="button" class="btn-modal-action-edit" id="btnPreviewEdit">
              ✏️ Modifier l'œuvre
            </button>
            <a href="/?photo=${photo.id}" target="_blank" class="btn-modal-action-view">
              👁 Ouvrir dans le Diaporama 3D ↗
            </a>
          `;
          document.getElementById('btnPreviewEdit')?.addEventListener('click', () => {
            closePreviewModal();
            openEditModal(photo);
          });
        } else {
          // Soumission citoyenne
          previewModalButtons.innerHTML = `
            <button type="button" class="btn-modal-action-reject" id="btnPreviewReject">
              ✕ Rejeter
            </button>
            <button type="button" class="btn-modal-action-approve" id="btnPreviewApprove">
              ✓ Approuver pour le Diaporama 3D
            </button>
          `;
          document.getElementById('btnPreviewApprove')?.addEventListener('click', async () => {
            await photoStore.approvePhoto(photo.id);
            closePreviewModal();
            await reloadAllData();
          });
          document.getElementById('btnPreviewReject')?.addEventListener('click', async () => {
            await photoStore.rejectPhoto(photo.id);
            closePreviewModal();
            await reloadAllData();
          });
        }
      }

      // Ratio d'aspect
      const img = new Image();
      img.src = photo.image_url;
      img.onload = () => {
        const aspect = img.naturalWidth / img.naturalHeight;
        const isPortrait = aspect < 0.95;

        if (previewModalRatio) {
          previewModalRatio.textContent = isPortrait ? '📱 Format : 9:16 Portrait' : '💻 Format : 16:9 Paysage';
        }

        if (previewFormatTip) {
          if (isPortrait) {
            previewFormatTip.innerHTML = '✨ <strong>Photo Verticale (9:16)</strong> : Le shader la centre et ajoute un <em>flou bokeh sombre</em> cinématique en vue Laptop.';
          } else {
            previewFormatTip.innerHTML = '✨ <strong>Photo Horizontale (16:9)</strong> : Remplissage parfait de l’écran sur Laptop, cadrée au centre sur Smartphone.';
          }
        }

        if (laptopImageHolder && laptopBgBlur) {
          if (isPortrait) {
            laptopImageHolder.classList.add('portrait-framed');
            laptopBgBlur.style.display = 'block';
          } else {
            laptopImageHolder.classList.remove('portrait-framed');
            laptopBgBlur.style.display = 'none';
          }
        }
      };

      setDeviceView('laptop');
      previewBackdrop.classList.add('open');
      previewBackdrop.setAttribute('aria-hidden', 'false');
    }

    function closePreviewModal() {
      if (!previewBackdrop) return;
      previewBackdrop.classList.remove('open');
      previewBackdrop.setAttribute('aria-hidden', 'true');
      currentPreviewPhoto = null;
    }

    function setDeviceView(device: 'laptop' | 'mobile') {
      if (device === 'laptop') {
        btnDeviceLaptop?.classList.add('active');
        btnDeviceMobile?.classList.remove('active');
        if (frameLaptop) frameLaptop.style.display = 'flex';
        if (frameMobile) frameMobile.style.display = 'none';
      } else {
        btnDeviceLaptop?.classList.remove('active');
        btnDeviceMobile?.classList.add('active');
        if (frameLaptop) frameLaptop.style.display = 'none';
        if (frameMobile) frameMobile.style.display = 'flex';
      }
    }

    btnDeviceLaptop?.addEventListener('click', () => setDeviceView('laptop'));
    btnDeviceMobile?.addEventListener('click', () => setDeviceView('mobile'));
    btnClosePreview?.addEventListener('click', closePreviewModal);

    previewBackdrop?.addEventListener('click', (e) => {
      if (e.target === previewBackdrop) closePreviewModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (previewBackdrop?.classList.contains('open')) closePreviewModal();
        if (addModalBackdrop?.classList.contains('open')) closeAddModal();
        if (editModalBackdrop?.classList.contains('open')) closeEditModal();
        if (deleteModalBackdrop?.classList.contains('open')) closeDeleteModal();
      }
    });

    // Authentification boutons
    btnGoogle?.addEventListener('click', async () => {
      await photoStore.loginWithGoogle();
    });

    btnLogout?.addEventListener('click', async () => {
      await photoStore.logout();
      await checkAuth();
    });

    window.addEventListener('mvett:auth-changed', () => {
      checkAuth();
    });

    window.addEventListener('mvett:catalog-updated', () => {
      reloadAllData();
    });

    window.addEventListener('mvett:photos-updated', () => {
      reloadAllData();
    });

    initColorPickers();
    checkAuth();
  });
</script>

<style is:global>
  html, body {
    height: auto !important;
    min-height: 100% !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    user-select: auto !important;
