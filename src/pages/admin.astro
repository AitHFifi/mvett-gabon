---
import Layout from '../layouts/Layout.astro';
import { provinces } from '../data/provinces';
---

<Layout title="MVETT — Curation & Gestion du Diaporama 3D" allowScroll={true}>
  <div class="admin-wrapper" id="adminWrapper">
    
    <!-- Top Navigation Header -->
    <header class="admin-header">
      <div class="header-left">
        <a href="/" class="brand-link" title="Retour au Diaporama">
          <span class="brand-title">MVETT</span>
          <span class="admin-pill">Curation & Modération</span>
        </a>
      </div>

      <div class="header-right">
        <a href="/" class="btn-back-home">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Retour au Diaporama 3D</span>
        </a>

        <!-- Pastille utilisateur -->
        <div class="user-pill" id="adminUserPill" style="display: none;">
          <img class="user-avatar" id="adminUserAvatar" src="" alt="" />
          <span class="user-name" id="adminUserName"></span>
          <button class="btn-logout" id="adminBtnLogout" title="Déconnexion" type="button">✕</button>
        </div>
      </div>
    </header>

    <!-- Écran de verrouillage / Connexion si non-admin -->
    <section class="admin-auth-gate" id="adminAuthGate" style="display: none;">
      <div class="gate-card">
        <div class="gate-badge">Accès Réservé</div>
        <h1 class="gate-title">Espace Curation du Patrimoine</h1>
        <p class="gate-desc">
          Cet espace permet de gérer l'ensemble des œuvres du diaporama 3D, de réordonner les photos des 9 provinces, d'ajouter de nouveaux clichés officiels et de modérer les contributions citoyennes.
        </p>

        <div class="gate-actions">
          <button type="button" class="btn-google-login" id="btnAdminGoogle">
            <svg viewBox="0 0 24 24" width="18" height="18">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Connexion Google (Compte Curateur)</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Tableau de bord complet (Actif une fois connecté en admin) -->
    <main class="admin-dashboard" id="adminDashboard" style="display: none;">

      <!-- Barre de navigation des 2 Espaces Principaux -->
      <div class="admin-view-nav">
        <button type="button" class="view-nav-tab active" id="tabNavCatalog" data-view="catalog">
          <span class="tab-nav-icon">🎨</span>
          <span class="tab-nav-title">Catalogue Diaporama 3D</span>
          <span class="tab-nav-badge" id="badgeCatalogActiveCount">0</span>
        </button>
        <button type="button" class="view-nav-tab" id="tabNavModeration" data-view="moderation">
          <span class="tab-nav-icon">⏳</span>
          <span class="tab-nav-title">Modération Citoyenne</span>
          <span class="tab-nav-badge pending" id="badgeModerationPendingCount">0</span>
        </button>
      </div>

      <!-- ======================================================== -->
      <!-- ESPACE 1 : CATALOGUE & DIAPORAMA 3D -->
      <!-- ======================================================== -->
      <section class="admin-view-section" id="sectionCatalog">
        
        <!-- Header du Catalogue avec Action "+ Ajouter une œuvre" -->
        <div class="catalog-section-header">
          <div>
            <h2 class="section-heading">Curation & Ordre du Diaporama</h2>
            <p class="section-subheading">
              Gérez les œuvres diffusées dans le grand carrousel 3D. Modifiez les textes et couleurs d'ambiance, réordonnez les diapositives par province ou ajoutez de nouvelles images.
            </p>
          </div>

          <button type="button" class="btn-add-primary" id="btnOpenAddModal">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>+ Ajouter une photo au Diaporama</span>
          </button>
        </div>

        <!-- Filtres du Catalogue -->
        <div class="catalog-toolbar">
          <div class="toolbar-left">
            <div class="segmented-chips">
              <button type="button" class="chip-btn active" id="chipCatalogActive" data-catalog-status="active">
                Diffusées en 3D <span class="chip-count" id="countCatalogActive">0</span>
              </button>
              <button type="button" class="chip-btn" id="chipCatalogArchived" data-catalog-status="archived">
                Archivées / Masquées <span class="chip-count" id="countCatalogArchived">0</span>
              </button>
            </div>
          </div>

          <div class="toolbar-right">
            <label for="catalogProvinceFilter" class="filter-label">Province :</label>
            <select id="catalogProvinceFilter" class="admin-select">
              <option value="all">Toutes les provinces (G1 à G9)</option>
              {provinces.map((prov) => (
                <option value={prov.id}>
                  {prov.code} — {prov.name} ({prov.capital})
                </option>
              ))}
            </select>
          </div>
        </div>

        <!-- Grille du Catalogue 3D -->
        <div class="catalog-grid" id="catalogGrid">
          <!-- Rempli dynamiquement en JS -->
        </div>

        <!-- État vide Catalogue -->
        <div class="admin-empty-state" id="catalogEmptyState" style="display: none;">
          <div class="empty-icon">🖼️</div>
          <h3 class="empty-title">Aucune photo dans cette sélection</h3>
          <p class="empty-desc">Aucune photographie ne correspond aux critères de filtre sélectionnés.</p>
          <button type="button" class="btn-empty-action" id="btnEmptyAddPhoto">+ Ajouter une première photo</button>
        </div>
      </section>


      <!-- ======================================================== -->
      <!-- ESPACE 2 : MODÉRATION DES CONTRIBUTIONS CITOYENNES -->
      <!-- ======================================================== -->
      <section class="admin-view-section" id="sectionModeration" style="display: none;">
        
        <!-- KPI Stats Bar -->
        <div class="kpi-grid">
          <div class="kpi-card highlight-pending">
            <div class="kpi-icon">⏳</div>
            <div class="kpi-data">
              <span class="kpi-value" id="countPending">0</span>
              <span class="kpi-label">À valider (Pending)</span>
            </div>
          </div>

          <div class="kpi-card highlight-approved">
            <div class="kpi-icon">✓</div>
            <div class="kpi-data">
              <span class="kpi-value" id="countApproved">0</span>
              <span class="kpi-label">Validées Citoyennes</span>
            </div>
          </div>

          <div class="kpi-card">
            <div class="kpi-icon">📷</div>
            <div class="kpi-data">
              <span class="kpi-value" id="countTotal">0</span>
              <span class="kpi-label">Total Soumissions</span>
            </div>
          </div>

          <div class="kpi-card">
            <div class="kpi-icon">🇬🇦</div>
            <div class="kpi-data">
              <span class="kpi-value">9 / 9</span>
              <span class="kpi-label">Provinces du Gabon</span>
            </div>
          </div>
        </div>

        <!-- Contrôles et Filtres Modération -->
        <div class="admin-controls">
          <div class="status-tabs">
            <button type="button" class="tab-btn active" data-mod-status="pending">
              ⏳ En attente <span class="tab-counter" id="tabPendingBadge">0</span>
            </button>
            <button type="button" class="tab-btn" data-mod-status="approved">
              ✓ Approuvées <span class="tab-counter" id="tabApprovedBadge">0</span>
            </button>
            <button type="button" class="tab-btn" data-mod-status="all">
              Toutes les soumissions
            </button>
          </div>

          <div class="province-selector-wrapper">
            <select id="adminProvinceFilter" class="admin-select">
              <option value="all">Toutes les provinces (G1 à G9)</option>
              {provinces.map((prov) => (
                <option value={prov.id}>
                  {prov.code} — {prov.name} ({prov.capital})
                </option>
              ))}
            </select>
          </div>
        </div>

        <!-- Grille des photographies soumises -->
        <div class="submissions-grid" id="submissionsGrid">
          <!-- Rempli dynamiquement en JS -->
        </div>

        <!-- État vide Modération -->
        <div class="admin-empty-state" id="adminEmptyState" style="display: none;">
          <div class="empty-icon">🌿</div>
          <h3 class="empty-title">Aucune soumission citoyenne en attente</h3>
          <p class="empty-desc">Toutes les contributions ont été traitées ou aucune photo ne correspond aux filtres.</p>
        </div>
      </section>

    </main>

    <!-- ======================================================== -->
    <!-- MODALE 1 : AJOUTER UNE PHOTO AU DIAPORAMA 3D -->
    <!-- ======================================================== -->
    <div class="admin-modal-backdrop" id="adminAddModalBackdrop" aria-hidden="true">
      <div class="admin-modal-box" role="dialog" aria-modal="true" aria-labelledby="addModalTitle">
        
        <header class="admin-modal-header">
          <div class="modal-title-wrap">
            <span class="modal-badge-pill">Diaporama Officiel</span>
            <h2 class="modal-main-title" id="addModalTitle">Ajouter une Œuvre au Diaporama</h2>
          </div>
          <button type="button" class="btn-close-box" id="btnCloseAddModal" aria-label="Fermer">✕</button>
        </header>

        <form id="adminAddForm" class="modal-form">
          <div class="modal-form-body">
            
            <!-- Choix de la Province -->
            <div class="form-group">
              <label for="addProvinceSelect" class="field-label">Province du Gabon *</label>
              <select id="addProvinceSelect" class="field-input" required>
                {provinces.map((prov) => (
                  <option value={prov.id}>
                    {prov.code} — {prov.name} ({prov.capital})
                  </option>
                ))}
              </select>
            </div>

            <!-- Titre & Lieu -->
            <div class="form-row-2">
              <div class="form-group">
                <label for="addTitleInput" class="field-label">Titre de la photographie *</label>
                <input type="text" id="addTitleInput" class="field-input" placeholder="Ex: Forêt Sacrée des Monts de Cristal" required maxlength="90" />
              </div>
              <div class="form-group">
                <label for="addLocationInput" class="field-label">Lieu géographique précis *</label>
                <input type="text" id="addLocationInput" class="field-input" placeholder="Ex: Parc National des Monts de Cristal · Estuaire" required maxlength="100" />
              </div>
            </div>

            <!-- Légende / Contexte culturel -->
            <div class="form-group">
              <label for="addCaptionInput" class="field-label">Légende poétique ou descriptive (Optionnelle)</label>
              <textarea id="addCaptionInput" class="field-textarea" rows="2" placeholder="Une phrase décrivant l'ambiance, la faune, la flore ou l'histoire ancestrale du lieu..."></textarea>
            </div>

            <!-- Couleur d'ambiance 3D -->
            <div class="form-group">
              <label class="field-label">Couleur d'Ambiance de Fond 3D</label>
              <p class="field-hint">Teinte atmosphérique qui habille l'arrière-plan lorsque la photo est affichée dans le WebGL.</p>
              
              <div class="color-picker-row">
                <div class="color-presets" id="addColorPresets">
                  <!-- Swatches injectés dynamiquement -->
                </div>
                <div class="custom-color-wrap">
                  <input type="color" id="addColorNativePicker" value="#1b2c34" class="native-color-picker" />
                  <input type="text" id="addColorHexInput" value="#1b2c34" class="hex-text-input" maxlength="7" />
                </div>
              </div>
            </div>

            <!-- Onglets Source de l'image (Fichier vs URL) -->
            <div class="form-group">
              <label class="field-label">Source de la Photographie *</label>
              <div class="source-tab-switcher">
                <button type="button" class="source-tab active" id="btnSourceUrl" data-mode="url">
                  🔗 Lien URL Direct (Unsplash, CDN...)
                </button>
                <button type="button" class="source-tab" id="btnSourceFile" data-mode="file">
                  📁 Téléverser un Fichier (avec WebP)
                </button>
              </div>

              <!-- Option A : Lien URL Direct -->
              <div class="source-panel" id="panelSourceUrl">
                <input type="url" id="addUrlInput" class="field-input" placeholder="https://images.unsplash.com/... ou https://..." />
                <p class="field-hint">Entrez un lien direct vers une image JPG, PNG ou WEBP haute résolution.</p>
              </div>

              <!-- Option B : Téléversement Fichier -->
              <div class="source-panel" id="panelSourceFile" style="display: none;">
                <div class="dropzone" id="addDropzone">
                  <input type="file" id="addFileInput" class="file-input" accept="image/jpeg,image/png,image/webp" />
                  <div class="dropzone-body">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="17 8 12 3 7 8"></polyline>
                      <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <p class="dropzone-text">Glissez votre photo ici ou <span>parcourez vos fichiers</span></p>
                    <span class="dropzone-sub">Compression WebP 2.5K automatique</span>
                  </div>
                </div>
                <div class="compression-status-bar" id="addCompressionStatus" style="display: none;">
                  <span class="compress-icon">⚡</span>
                  <span id="addCompressionText">Prêt</span>
                </div>
              </div>
            </div>

            <!-- Aperçu instantané -->
            <div class="image-live-preview-box" id="addImagePreviewBox" style="display: none;">
              <span class="preview-box-label">Aperçu en direct :</span>
              <div class="preview-img-frame" id="addPreviewFrame">
                <img id="addLiveImg" src="" alt="Aperçu" />
              </div>
            </div>

          </div>

          <footer class="modal-form-footer">
            <button type="button" class="btn-modal-cancel" id="btnCancelAddModal">Annuler</button>
            <button type="submit" class="btn-modal-submit" id="btnSubmitAdd">
              ✓ Publier immédiatement dans le Diaporama 3D
            </button>
          </footer>
        </form>

      </div>
    </div>

    <!-- ======================================================== -->
    <!-- MODALE 2 : MODIFIER UNE PHOTO DU DIAPORAMA 3D -->
    <!-- ======================================================== -->
    <div class="admin-modal-backdrop" id="adminEditModalBackdrop" aria-hidden="true">
      <div class="admin-modal-box" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
        
        <header class="admin-modal-header">
          <div class="modal-title-wrap">
            <span class="modal-badge-pill edit">Édition d'Œuvre</span>
            <h2 class="modal-main-title" id="editModalTitle">Modifier les Informations</h2>
          </div>
          <button type="button" class="btn-close-box" id="btnCloseEditModal" aria-label="Fermer">✕</button>
        </header>

        <form id="adminEditForm" class="modal-form">
          <input type="hidden" id="editPhotoId" />

          <div class="modal-form-body">
            
            <!-- Province -->
            <div class="form-group">
              <label for="editProvinceSelect" class="field-label">Province réassignée *</label>
              <select id="editProvinceSelect" class="field-input" required>
                {provinces.map((prov) => (
                  <option value={prov.id}>
                    {prov.code} — {prov.name} ({prov.capital})
                  </option>
                ))}
              </select>
            </div>

            <!-- Titre & Lieu -->
            <div class="form-row-2">
              <div class="form-group">
                <label for="editTitleInput" class="field-label">Titre de l'œuvre *</label>
                <input type="text" id="editTitleInput" class="field-input" required maxlength="90" />
              </div>
              <div class="form-group">
                <label for="editLocationInput" class="field-label">Lieu géographique *</label>
                <input type="text" id="editLocationInput" class="field-input" required maxlength="100" />
              </div>
            </div>

            <!-- Légende -->
            <div class="form-group">
              <label for="editCaptionInput" class="field-label">Légende / Récit culturel</label>
              <textarea id="editCaptionInput" class="field-textarea" rows="2"></textarea>
            </div>

            <!-- Couleur d'ambiance -->
            <div class="form-group">
              <label class="field-label">Couleur d'Ambiance de Fond 3D</label>
              <div class="color-picker-row">
                <div class="color-presets" id="editColorPresets"></div>
                <div class="custom-color-wrap">
                  <input type="color" id="editColorNativePicker" value="#1b2c34" class="native-color-picker" />
                  <input type="text" id="editColorHexInput" value="#1b2c34" class="hex-text-input" maxlength="7" />
                </div>
              </div>
            </div>

            <!-- Remplacement d'Image (Optionnel) -->
            <div class="form-group">
              <label class="field-label">Image Actuelle & Remplacement</label>
              <div class="edit-current-image-card">
                <img id="editCurrentImgThumb" src="" alt="" class="current-thumb" />
                <div class="current-img-meta">
                  <span class="current-img-status">Image actuellement diffusée</span>
                  <button type="button" class="btn-toggle-replace-img" id="btnToggleReplaceImg">
                    🔄 Changer l'image...
                  </button>
                </div>
              </div>

              <!-- Bloc pour fournir une nouvelle image si demandé -->
              <div class="replace-image-drawer" id="replaceImageDrawer" style="display: none;">
                <div class="source-tab-switcher">
                  <button type="button" class="source-tab active" id="btnEditSourceUrl" data-mode="url">
                    🔗 Nouveau Lien URL
                  </button>
                  <button type="button" class="source-tab" id="btnEditSourceFile" data-mode="file">
                    📁 Nouveau Fichier
                  </button>
                </div>

                <div class="source-panel" id="panelEditSourceUrl">
                  <input type="url" id="editUrlInput" class="field-input" placeholder="https://..." />
                </div>

                <div class="source-panel" id="panelEditSourceFile" style="display: none;">
                  <input type="file" id="editFileInput" class="field-input" accept="image/jpeg,image/png,image/webp" />
                  <div class="compression-status-bar" id="editCompressionStatus" style="display: none;">
                    <span class="compress-icon">⚡</span>
                    <span id="editCompressionText">Prêt</span>
                  </div>
                </div>
              </div>
            </div>

          </div>

          <footer class="modal-form-footer">
            <button type="button" class="btn-modal-cancel" id="btnCancelEditModal">Annuler</button>
            <button type="submit" class="btn-modal-submit" id="btnSubmitEdit">
              💾 Enregistrer les Modifications
            </button>
          </footer>
        </form>

      </div>
    </div>

    <!-- ======================================================== -->
    <!-- MODALE 3 : CONFIRMATION SUPPRESSION OU ARCHIVAGE -->
    <!-- ======================================================== -->
    <div class="admin-modal-backdrop" id="adminDeleteModalBackdrop" aria-hidden="true">
      <div class="admin-modal-box compact" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
        
        <header class="admin-modal-header">
          <h2 class="modal-main-title danger" id="deleteModalTitle">Retirer du Diaporama</h2>
          <button type="button" class="btn-close-box" id="btnCloseDeleteModal" aria-label="Fermer">✕</button>
        </header>

        <div class="delete-modal-body">
          <div class="delete-photo-summary">
            <img id="deleteModalThumb" src="" alt="" class="delete-thumb" />
            <div class="delete-meta">
              <span class="delete-title" id="deleteModalTitleText">Titre</span>
              <span class="delete-loc" id="deleteModalLocText">Lieu</span>
            </div>
          </div>

          <p class="delete-lead-text">
            Choisissez l'action à appliquer à cette photographie :
          </p>

          <div class="delete-choice-cards">
            <!-- Option 1 : Archiver -->
            <button type="button" class="choice-card" id="btnChoiceArchive">
              <div class="choice-icon">📦</div>
              <div class="choice-content">
                <strong>Archiver / Masquer (Recommandé)</strong>
                <p>Retire immédiatement la photo du diaporama 3D public. Vous pourrez la restaurer en 1 clic à tout moment depuis l'onglet "Archivées".</p>
              </div>
            </button>

            <!-- Option 2 : Supprimer Définitivement -->
            <button type="button" class="choice-card danger" id="btnChoicePermanent">
              <div class="choice-icon">🗑️</div>
              <div class="choice-content">
                <strong>Supprimer Définitivement</strong>
                <p>Efface irrévocablement la photographie de la base de données et du stockage.</p>
              </div>
            </button>
          </div>
        </div>

        <footer class="modal-form-footer">
          <button type="button" class="btn-modal-cancel" id="btnCancelDeleteModal">Annuler</button>
        </footer>

      </div>
    </div>

    <!-- ======================================================== -->
    <!-- MODALE 4 : STUDIO DE PRÉVISUALISATION MULTI-ÉCRANS (3D) -->
    <!-- ======================================================== -->
    <div class="preview-modal-backdrop" id="previewModalBackdrop" aria-hidden="true">
      <div class="preview-modal-container" role="dialog" aria-modal="true" aria-labelledby="previewModalTitle">
        
        <!-- Header du studio -->
        <header class="preview-modal-header">
          <div class="preview-header-info">
            <div class="preview-badge-row">
              <span class="preview-badge-province" id="previewModalProvince">G1 · Estuaire</span>
              <span class="preview-badge-ratio" id="previewModalRatio">Format : Détection</span>
              <span class="preview-badge-status" id="previewModalStatus">En ligne</span>
            </div>
            <h2 class="preview-modal-title" id="previewModalTitle">Titre de l'œuvre</h2>
            <p class="preview-modal-location" id="previewModalLocation">Lieu · Auteur</p>
          </div>

          <!-- Switcher d'Écrans Interactif -->
          <div class="device-switcher" role="tablist">
            <button type="button" class="device-btn active" data-device="laptop" id="btnDeviceLaptop">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
              <span>💻 Laptop (16:9)</span>
            </button>
            <button type="button" class="device-btn" data-device="mobile" id="btnDeviceMobile">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                <line x1="12" y1="18" x2="12.01" y2="18"></line>
              </svg>
              <span>📱 Smartphone (9:16)</span>
            </button>
          </div>

          <button type="button" class="btn-close-modal" id="btnClosePreviewModal" aria-label="Fermer le studio">✕</button>
        </header>

        <!-- Stage de Rendu & Simulation -->
        <div class="preview-stage-viewport">
          
          <!-- Mode Laptop (16:9) -->
          <div class="screen-frame-laptop" id="frameLaptop">
            <div class="laptop-bezel">
              <div class="laptop-display" id="laptopDisplay">
                <div class="laptop-bg-blur" id="laptopBgBlur"></div>
                <div class="laptop-image-holder" id="laptopImageHolder">
                  <img src="" id="laptopMainImg" alt="Prévisualisation Laptop" />
                </div>
                <div class="hud-mock-overlay">
                  <div class="hud-mock-top">
                    <span class="mock-brand">MVETT</span>
                    <span class="mock-counter" id="laptopMockCounter">01 / 03 · G1 ESTUAIRE</span>
                  </div>
                  <div class="hud-mock-bottom">
                    <h4 class="mock-title" id="laptopMockTitle">Titre de l'œuvre</h4>
                    <p class="mock-loc" id="laptopMockLoc">Lieu précis</p>
                  </div>
                </div>
